---
interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  breadcrumbs?: Breadcrumb[];
  keywords?: string[];
}

const defaultDescription = 'Will Jarvis is a Creative Producer and Scriptwriter based in London. Branded content, film, TV development, theatre and immersive.';
const { title, description: rawDescription = defaultDescription, image, type = 'website', jsonLd, breadcrumbs, keywords } = Astro.props;
const description = rawDescription.length > 160 ? rawDescription.slice(0, 157).replace(/\s+\S*$/, '') + '...' : rawDescription;
const siteUrl = 'https://willjarvis.co';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

function resolveOgImage(img?: string): string {
  if (!img) return `${siteUrl}/images/portrait.webp`;
  if (img.endsWith('.gif')) {
    const thumb = 'images/thumbs/' + img.replace('images/', '').replace('.gif', '.webp');
    return new URL(thumb, siteUrl + '/').href;
  }
  return new URL(img, siteUrl + '/').href;
}
const ogImage = resolveOgImage(image);
const ogImageAlt = image ? title : 'Will Jarvis, Creative Producer and Scriptwriter';

const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": crumb.name,
    "item": crumb.url,
  })),
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="6jp6jyMTZRgg_rX8xJa9CQjIlT4lMh7X9IkthYCGLxI" />
    <meta name="description" content={description} />
    <meta name="author" content="Will Jarvis" />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Will Jarvis" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Will Jarvis",
      "alternateName": "William Jarvis",
      "url": siteUrl,
      "image": `${siteUrl}/images/portrait.webp`,
      "description": "Creative Producer and Scriptwriter based in London, producing branded content for global brands including Hamilton Watches, Chelsea FC, Manchester City, Booking.com, and Formula 1.",
      "disambiguatingDescription": "London-based Creative Producer and Scriptwriter at RD Content, producing branded content, short films, and TV development.",
      "jobTitle": "Creative Producer & Scriptwriter",
      "worksFor": {
        "@type": "Organization",
        "name": "RD Content",
        "url": "https://www.rdcontent.com"
      },
      "address": { "@type": "PostalAddress", "addressLocality": "London", "addressCountry": "GB" },
      "alumniOf": [
        { "@type": "EducationalOrganization", "name": "Royal Central School of Speech and Drama" },
        { "@type": "EducationalOrganization", "name": "University of Exeter" }
      ],
      "knowsAbout": ["Branded Content Production", "Film Production", "Scriptwriting", "TV Development", "Commercial Production", "Creative Direction", "Theatre"],
      "award": [
        "Winner, Cannes Corporate Media & TV Awards 2026",
        "Three Platinum and one Gold MUSE Award",
        "Jury Award for Best Performance, Rob Knox International Film Festival 2025"
      ],
      "sameAs": [
        "https://www.imdb.com/name/nm15210832/",
        "https://www.linkedin.com/in/will-t-jarvis/",
        "https://www.instagram.com/willjarvis.1996/"
      ]
    })} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}

    <script is:inline>try{const t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch{}</script>
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav">
        <a href="/" class="nav-logo">WJ</a>
        <ul class="nav-links">
          <li><a href="/work" class="nav-link">Projects</a></li>
          <li><a href="/about" class="nav-link">About</a></li>
          <li><a href="/contact" class="nav-link">Contact</a></li>
        </ul>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span>
          <span></span>
        </button>
        <div class="nav-actions">
          <button class="theme-toggle" aria-label="Toggle dark mode">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-left">
          <p class="footer-text">&copy; {new Date().getFullYear()} Will Jarvis</p>
          <span class="footer-coord" aria-hidden="true">51.5074° N // 0.1278° W</span>
        </div>
        <div class="footer-links">
          <a href="https://www.imdb.com/name/nm15210832/" target="_blank" rel="noopener" aria-label="IMDb">
            <svg width="24" height="14" viewBox="0 0 64 32" fill="currentColor"><rect width="64" height="32" rx="4"/><text x="32" y="23" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="18" fill="var(--color-bg, #0a0a0a)">IMDb</text></svg>
          </a>
          <a href="https://www.linkedin.com/in/will-t-jarvis/" target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.instagram.com/willjarvis.1996/" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          </a>
        </div>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--header-height);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    transition: background 0.3s ease, border-color 0.3s ease;
  }


  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height);
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-fg);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .nav-logo:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: var(--space-md);
    list-style: none;
  }

  .nav-link {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-self: end;
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: var(--color-fg-muted);
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  .icon-sun { display: none; }
  .icon-moon { display: block; }

  :root[data-theme="dark"] .icon-sun { display: block; }
  :root[data-theme="dark"] .icon-moon { display: none; }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .icon-sun { display: block; }
    :root:not([data-theme="light"]) .icon-moon { display: none; }
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-xs);
    flex-direction: column;
    gap: 6px;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-fg);
    transition: transform 0.3s ease;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-sm) 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer-text {
    font-size: 0.6875rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-coord {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--color-marker);
    letter-spacing: 0.04em;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .footer-links a {
    color: var(--color-fg-muted);
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .nav-links {
      display: none;
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-bg);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-lg);
      z-index: 99;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      font-size: 1.25rem;
      letter-spacing: 0.08em;
      color: var(--color-fg);
    }

    .nav-toggle {
      display: flex;
      grid-column: 2;
      justify-self: center;
    }

    .nav-actions {
      grid-column: 3;
    }

    .footer-inner {
      flex-direction: column;
      gap: var(--space-xs);
      text-align: center;
    }

    .footer-left {
      flex-direction: column;
      gap: 0.25rem;
    }
  }


</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const links = document.querySelector('.nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }

  const themeBtn = document.querySelector('.theme-toggle');
  if (themeBtn) {
    try {
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    } catch {}

    themeBtn.addEventListener('click', () => {
      const isDark =
        document.documentElement.getAttribute('data-theme') === 'dark' ||
        (!document.documentElement.getAttribute('data-theme') &&
          window.matchMedia('(prefers-color-scheme: dark)').matches);

      const next = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch {}
    });
  }

  document.querySelectorAll<HTMLImageElement>('img[data-gif]').forEach((img) => {
    const gif = new Image();
    gif.src = img.dataset.gif!;
    gif.onload = () => { img.src = gif.src; };
  });
</script>
