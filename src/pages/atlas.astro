---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Atlas | Will Jarvis">
  <section class="atlas-page">
    <div class="atlas-bg" aria-hidden="true">
      <div class="compass-circles">
        <span class="circle circle-1"></span>
        <span class="circle circle-2"></span>
        <span class="circle circle-3"></span>
        <span class="circle circle-4"></span>
      </div>

      <div class="compass-lines">
        <span class="axis axis-h"></span>
        <span class="axis axis-v"></span>
        <span class="axis axis-d1"></span>
        <span class="axis axis-d2"></span>
      </div>

      <div class="compass-labels">
        <span class="cardinal cardinal-n">N</span>
        <span class="cardinal cardinal-s">S</span>
        <span class="cardinal cardinal-w">W</span>
        <span class="cardinal cardinal-e">E</span>
      </div>

      <svg class="route-lines" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <path d="M40,360 C90,310 140,220 200,190 S310,110 370,50" class="route-path route-blue"/>
        <path d="M360,370 C310,310 260,270 200,200 S110,130 40,40" class="route-path route-grey"/>
        <circle cx="200" cy="190" r="4" class="route-dot"/>
        <circle cx="310" cy="110" r="3" class="route-dot"/>
        <circle cx="110" cy="130" r="3" class="route-dot"/>
      </svg>

      <div class="map-dots">
        <span class="dot dot-1"></span>
        <span class="dot dot-2"></span>
        <span class="dot dot-3"></span>
        <span class="dot dot-4"></span>
        <span class="dot dot-5"></span>
        <span class="dot dot-6"></span>
      </div>

      <div class="corner-frame">
        <span class="corner corner-tl"></span>
        <span class="corner corner-tr"></span>
        <span class="corner corner-bl"></span>
        <span class="corner corner-br"></span>
      </div>

      <div class="coord-lines">
        <span class="coord coord-tl">51.5074 N</span>
        <span class="coord coord-tr">0.1278 W</span>
        <span class="coord coord-bl">37.9838 S</span>
        <span class="coord coord-br">23.5505 E</span>
        <span class="coord coord-ml">40.7128 N</span>
        <span class="coord coord-mr">74.0060 W</span>
      </div>
    </div>

    <div class="atlas-content">
      <p class="atlas-tag animate-in" style="--delay: 0.1s">*Atlas of Wanderings</p>
      <h1 class="atlas-title animate-in" style="--delay: 0.25s">Coming<br/>Soon</h1>

      <div class="atlas-pin animate-in" style="--delay: 0.35s">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" class="pin-icon">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="var(--atlas-pin)"/>
        </svg>
        <span class="pin-ring"></span>
        <span class="pin-ring pin-ring-2"></span>
      </div>

      <div class="atlas-rule animate-in" style="--delay: 0.4s"></div>
      <div class="atlas-desc animate-in" style="--delay: 0.45s">
        <p>An interactive map to chart everywhere you've been.</p>
      </div>
      <a href={base} class="atlas-back animate-in" style="--delay: 0.55s">&larr; Back to portfolio</a>
    </div>
  </section>
</Base>

<style>
  .atlas-page {
    --atlas-blue: #2b6cb0;
    --atlas-pin: #d62828;
    --atlas-line: #8ba4be;
    --atlas-bg: #edf2f7;

    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: var(--header-height) var(--space-sm) var(--space-lg);
    background: var(--atlas-bg);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .atlas-page {
      --atlas-line: rgba(255, 255, 255, 0.12);
      --atlas-blue: #5a9fe6;
      --atlas-pin: #ff4444;
      --atlas-bg: var(--color-bg);
    }
  }

  :root[data-theme="dark"] .atlas-page {
    --atlas-line: rgba(255, 255, 255, 0.12);
    --atlas-blue: #5a9fe6;
    --atlas-pin: #ff4444;
    --atlas-bg: var(--color-bg);
  }

  :root[data-theme="light"] .atlas-page {
    --atlas-line: #8ba4be;
    --atlas-blue: #2b6cb0;
    --atlas-pin: #d62828;
    --atlas-bg: #edf2f7;
  }

  .atlas-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  /* Compass circles - pure CSS borders, rotating */
  .compass-circles {
    position: absolute;
    width: 85vmin;
    max-width: 700px;
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: compass-drift 120s linear infinite;
    will-change: transform;
  }

  .circle {
    position: absolute;
    border-radius: 50%;
    border: 2px solid var(--atlas-line);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  .circle-1 {
    width: 100%;
    height: 100%;
    border-width: 3px;
  }

  .circle-2 {
    width: 78%;
    height: 78%;
  }

  .circle-3 {
    width: 56%;
    height: 56%;
  }

  .circle-4 {
    width: 34%;
    height: 34%;
  }

  /* Compass lines - rotate slowly */
  .compass-lines {
    position: absolute;
    width: 85vmin;
    max-width: 700px;
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: compass-drift 120s linear infinite;
    will-change: transform;
  }

  .axis {
    position: absolute;
    background: var(--atlas-line);
  }

  .axis-h {
    width: 100%;
    height: 1.5px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .axis-v {
    width: 1.5px;
    height: 100%;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
  }

  .axis-d1 {
    width: 141%;
    height: 1px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    transform-origin: center;
  }

  .axis-d2 {
    width: 141%;
    height: 1px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
    transform-origin: center;
  }

  @keyframes compass-drift {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  /* Cardinal labels */
  .compass-labels {
    position: absolute;
    width: 85vmin;
    max-width: 700px;
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .cardinal {
    position: absolute;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
  }

  .cardinal-n {
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--atlas-blue);
  }

  .cardinal-s {
    bottom: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--atlas-line);
  }

  .cardinal-w {
    left: -1.5rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--atlas-line);
  }

  .cardinal-e {
    right: -1.5rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--atlas-line);
  }

  /* Route lines */
  .route-lines {
    position: absolute;
    width: 90%;
    max-width: 700px;
    height: auto;
  }

  .route-path {
    fill: none;
    stroke-dasharray: 6 8;
    animation: route-flow 6s linear infinite;
  }

  .route-blue {
    stroke: var(--atlas-blue);
    stroke-width: 2;
    opacity: 0.5;
  }

  .route-grey {
    stroke: var(--atlas-line);
    stroke-width: 1.5;
    opacity: 0.4;
  }

  @keyframes route-flow {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -42; }
  }

  .route-dot {
    fill: var(--atlas-blue);
    opacity: 0.5;
    animation: dot-pulse 3s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.6; }
  }

  /* Map dots */
  .map-dots {
    position: absolute;
    inset: 0;
  }

  .dot {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--atlas-blue);
    animation: dot-blink 4s ease-in-out infinite;
  }

  .dot-1 { top: 28%; left: 22%; animation-delay: 0s; }
  .dot-2 { top: 18%; right: 30%; animation-delay: 1.2s; }
  .dot-3 { bottom: 35%; left: 18%; animation-delay: 2.4s; }
  .dot-4 { bottom: 25%; right: 22%; animation-delay: 0.6s; }
  .dot-5 { top: 45%; left: 35%; animation-delay: 1.8s; }
  .dot-6 { top: 38%; right: 18%; animation-delay: 3s; }

  @keyframes dot-blink {
    0%, 100% { opacity: 0; transform: scale(0.5); }
    20% { opacity: 0.7; transform: scale(1); }
    40% { opacity: 0.5; transform: scale(1); }
    60% { opacity: 0; transform: scale(0.5); }
  }

  /* Corner frame */
  .corner-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .corner {
    position: absolute;
    width: 40px;
    height: 40px;
  }

  .corner::before,
  .corner::after {
    content: '';
    position: absolute;
    background: var(--atlas-blue);
    opacity: 0.5;
  }

  .corner::before {
    width: 100%;
    height: 1.5px;
  }

  .corner::after {
    width: 1.5px;
    height: 100%;
  }

  .corner-tl { top: 8%; left: 6%; }
  .corner-tl::before { top: 0; left: 0; }
  .corner-tl::after { top: 0; left: 0; }

  .corner-tr { top: 8%; right: 6%; }
  .corner-tr::before { top: 0; right: 0; }
  .corner-tr::after { top: 0; right: 0; }

  .corner-bl { bottom: 8%; left: 6%; }
  .corner-bl::before { bottom: 0; left: 0; }
  .corner-bl::after { bottom: 0; left: 0; }

  .corner-br { bottom: 8%; right: 6%; }
  .corner-br::before { bottom: 0; right: 0; }
  .corner-br::after { bottom: 0; right: 0; }

  /* Coordinates */
  .coord-lines {
    position: absolute;
    inset: 0;
    opacity: 0.55;
  }

  .coord {
    position: absolute;
    font-size: 0.5rem;
    font-family: var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .coord-tl { top: 20%; left: 8%; }
  .coord-tr { top: 15%; right: 8%; }
  .coord-bl { bottom: 20%; left: 8%; }
  .coord-br { bottom: 15%; right: 8%; }
  .coord-ml { top: 50%; left: 8%; }
  .coord-mr { top: 50%; right: 8%; }

  /* Content */
  .atlas-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .atlas-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--atlas-blue);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .atlas-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 11vw, 9rem);
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  /* Pulsing pin */
  .atlas-pin {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-xs) 0;
  }

  .pin-icon {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 2px 6px rgba(214, 40, 40, 0.3));
    animation: pin-bob 3s ease-in-out infinite;
  }

  @keyframes pin-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .pin-ring {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--atlas-pin);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pin-ripple 3s ease-out infinite;
  }

  .pin-ring-2 {
    animation-delay: 1s;
  }

  @keyframes pin-ripple {
    0% { width: 12px; height: 12px; opacity: 0.5; }
    100% { width: 50px; height: 50px; opacity: 0; }
  }

  .atlas-rule {
    width: 48px;
    height: 1px;
    background: var(--atlas-blue);
    opacity: 0.7;
  }

  .atlas-desc {
    text-align: center;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .atlas-desc p {
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .atlas-back {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    font-weight: 500;
    transition: color 0.2s ease;
    margin-top: var(--space-sm);
  }

  .atlas-back:hover {
    color: var(--color-accent);
  }

  @media (max-width: 639px) {
    .coord-lines { display: none; }
    .corner-frame { display: none; }
    .route-lines { width: 120%; }

    .compass-circles,
    .compass-lines,
    .compass-labels {
      width: 90vmin;
    }
  }
</style>
