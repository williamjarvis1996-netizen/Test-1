---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Atlas | Will Jarvis">
  <section class="atlas-page">
    <div class="atlas-bg" aria-hidden="true">
      <div class="compass-rose">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="compass-svg">
          <circle cx="100" cy="100" r="95" fill="none" stroke="var(--color-atlas-line)" stroke-width="0.5"/>
          <circle cx="100" cy="100" r="80" fill="none" stroke="var(--color-atlas-line)" stroke-width="0.3"/>
          <circle cx="100" cy="100" r="60" fill="none" stroke="var(--color-atlas-line)" stroke-width="0.3"/>
          <circle cx="100" cy="100" r="40" fill="none" stroke="var(--color-atlas-line)" stroke-width="0.3"/>
          <line x1="5" y1="100" x2="195" y2="100" stroke="var(--color-atlas-line)" stroke-width="0.3"/>
          <line x1="100" y1="5" x2="100" y2="195" stroke="var(--color-atlas-line)" stroke-width="0.3"/>
          <line x1="17" y1="17" x2="183" y2="183" stroke="var(--color-atlas-line)" stroke-width="0.2"/>
          <line x1="183" y1="17" x2="17" y2="183" stroke="var(--color-atlas-line)" stroke-width="0.2"/>
          <polygon points="100,8 103,30 100,25 97,30" fill="var(--color-atlas-gold)" opacity="0.6"/>
          <polygon points="100,192 103,170 100,175 97,170" fill="var(--color-atlas-line)" opacity="0.3"/>
          <polygon points="8,100 30,97 25,100 30,103" fill="var(--color-atlas-line)" opacity="0.3"/>
          <polygon points="192,100 170,97 175,100 170,103" fill="var(--color-atlas-line)" opacity="0.3"/>
          <text x="100" y="5" text-anchor="middle" font-size="5" fill="var(--color-atlas-gold)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.5">N</text>
          <text x="100" y="199" text-anchor="middle" font-size="5" fill="var(--color-atlas-line)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.3">S</text>
          <text x="3" y="101.5" text-anchor="middle" font-size="5" fill="var(--color-atlas-line)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.3">W</text>
          <text x="197" y="101.5" text-anchor="middle" font-size="5" fill="var(--color-atlas-line)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.3">E</text>
        </svg>
      </div>

      <div class="coord-lines" aria-hidden="true">
        <span class="coord coord-tl">51.5074 N</span>
        <span class="coord coord-tr">0.1278 W</span>
        <span class="coord coord-bl">37.9838 S</span>
        <span class="coord coord-br">23.5505 E</span>
      </div>
    </div>

    <div class="atlas-content">
      <p class="atlas-tag animate-in" style="--delay: 0.1s">*Atlas of Wanderings</p>
      <h1 class="atlas-title animate-in" style="--delay: 0.25s">Coming<br/>Soon</h1>
      <div class="atlas-rule animate-in" style="--delay: 0.35s"></div>
      <p class="atlas-desc animate-in" style="--delay: 0.4s">
        An interactive map charting everywhere I've been.<br/>
        26 countries across 5 continents. 180 locations pinned.
      </p>
      <div class="atlas-stats animate-in" style="--delay: 0.5s">
        <div class="stat">
          <span class="stat-num">26</span>
          <span class="stat-label">Countries</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">5</span>
          <span class="stat-label">Continents</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">180</span>
          <span class="stat-label">Pinned</span>
        </div>
      </div>
      <a href={base} class="atlas-back animate-in" style="--delay: 0.6s">&larr; Back to portfolio</a>
    </div>
  </section>
</Base>

<style>
  .atlas-page {
    --color-atlas-gold: #c4993a;
    --color-atlas-line: var(--color-fg-muted);

    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: var(--header-height) var(--space-sm) var(--space-lg);
  }

  .atlas-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .compass-rose {
    position: absolute;
    width: 80%;
    max-width: 550px;
    opacity: 0.12;
    animation: compass-drift 90s linear infinite;
  }

  .compass-svg {
    width: 100%;
    height: auto;
  }

  @keyframes compass-drift {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .coord-lines {
    position: absolute;
    inset: 0;
    opacity: 0.15;
  }

  .coord {
    position: absolute;
    font-size: 0.5rem;
    font-family: var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .coord-tl { top: 20%; left: 8%; }
  .coord-tr { top: 15%; right: 8%; }
  .coord-bl { bottom: 20%; left: 8%; }
  .coord-br { bottom: 15%; right: 8%; }

  .atlas-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .atlas-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-atlas-gold);
    font-weight: 600;
  }

  .atlas-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 10rem);
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-fg);
  }

  .atlas-rule {
    width: 60px;
    height: 1px;
    background: var(--color-atlas-gold);
    margin: var(--space-xs) 0;
    opacity: 0.6;
  }

  .atlas-desc {
    font-size: 0.875rem;
    color: var(--color-fg-muted);
    max-width: 340px;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  .atlas-stats {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--color-atlas-gold);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 600;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
    opacity: 0.5;
  }

  .atlas-back {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    font-weight: 500;
    transition: color 0.2s ease;
    margin-top: var(--space-xs);
  }

  .atlas-back:hover {
    color: var(--color-accent);
  }

  @media (max-width: 639px) {
    .atlas-stats {
      gap: var(--space-sm);
    }

    .stat-divider {
      height: 24px;
    }

    .coord-lines {
      display: none;
    }
  }
</style>
