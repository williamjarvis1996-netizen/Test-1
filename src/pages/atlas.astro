---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Atlas | Will Jarvis">
  <section class="atlas-page">
    <div class="atlas-bg" aria-hidden="true">
      <div class="compass-rose">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="compass-svg">
          <circle cx="100" cy="100" r="95" fill="none" stroke="var(--color-atlas-line)" stroke-width="1"/>
          <circle cx="100" cy="100" r="80" fill="none" stroke="var(--color-atlas-line)" stroke-width="0.6"/>
          <circle cx="100" cy="100" r="60" fill="none" stroke="var(--color-atlas-line)" stroke-width="0.6"/>
          <circle cx="100" cy="100" r="40" fill="none" stroke="var(--color-atlas-line)" stroke-width="0.6"/>
          <line x1="5" y1="100" x2="195" y2="100" stroke="var(--color-atlas-line)" stroke-width="0.6"/>
          <line x1="100" y1="5" x2="100" y2="195" stroke="var(--color-atlas-line)" stroke-width="0.6"/>
          <line x1="17" y1="17" x2="183" y2="183" stroke="var(--color-atlas-line)" stroke-width="0.4"/>
          <line x1="183" y1="17" x2="17" y2="183" stroke="var(--color-atlas-line)" stroke-width="0.4"/>
          <polygon points="100,8 103,30 100,25 97,30" fill="var(--color-atlas-blue)" opacity="0.8"/>
          <polygon points="100,192 103,170 100,175 97,170" fill="var(--color-atlas-line)" opacity="0.6"/>
          <polygon points="8,100 30,97 25,100 30,103" fill="var(--color-atlas-line)" opacity="0.6"/>
          <polygon points="192,100 170,97 175,100 170,103" fill="var(--color-atlas-line)" opacity="0.6"/>
          <text x="100" y="5" text-anchor="middle" font-size="5" fill="var(--color-atlas-blue)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.8">N</text>
          <text x="100" y="199" text-anchor="middle" font-size="5" fill="var(--color-atlas-line)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.6">S</text>
          <text x="3" y="101.5" text-anchor="middle" font-size="5" fill="var(--color-atlas-line)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.6">W</text>
          <text x="197" y="101.5" text-anchor="middle" font-size="5" fill="var(--color-atlas-line)" font-family="var(--font-body)" letter-spacing="0.1em" opacity="0.6">E</text>
        </svg>
      </div>

      <svg class="route-lines" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <path d="M40,360 C90,310 140,220 200,190 S310,110 370,50" stroke="var(--color-atlas-blue)" stroke-width="1.5" stroke-dasharray="4 6" fill="none" opacity="0.5" class="route-path"/>
        <path d="M360,370 C310,310 260,270 200,200 S110,130 40,40" stroke="var(--color-atlas-line)" stroke-width="1" stroke-dasharray="3 5" fill="none" opacity="0.4" class="route-path"/>
        <circle cx="200" cy="190" r="3.5" fill="var(--color-atlas-blue)" opacity="0.5" class="route-dot"/>
        <circle cx="310" cy="110" r="2.5" fill="var(--color-atlas-blue)" opacity="0.4" class="route-dot"/>
        <circle cx="110" cy="130" r="2.5" fill="var(--color-atlas-blue)" opacity="0.4" class="route-dot"/>
      </svg>

      <div class="map-dots" aria-hidden="true">
        <span class="dot dot-1"></span>
        <span class="dot dot-2"></span>
        <span class="dot dot-3"></span>
        <span class="dot dot-4"></span>
        <span class="dot dot-5"></span>
        <span class="dot dot-6"></span>
      </div>

      <div class="corner-frame" aria-hidden="true">
        <span class="corner corner-tl"></span>
        <span class="corner corner-tr"></span>
        <span class="corner corner-bl"></span>
        <span class="corner corner-br"></span>
      </div>

      <div class="coord-lines" aria-hidden="true">
        <span class="coord coord-tl">51.5074 N</span>
        <span class="coord coord-tr">0.1278 W</span>
        <span class="coord coord-bl">37.9838 S</span>
        <span class="coord coord-br">23.5505 E</span>
        <span class="coord coord-ml">40.7128 N</span>
        <span class="coord coord-mr">74.0060 W</span>
      </div>
    </div>

    <div class="atlas-content">
      <p class="atlas-tag animate-in" style="--delay: 0.1s">*Atlas of Wanderings</p>
      <h1 class="atlas-title animate-in" style="--delay: 0.25s">Coming<br/>Soon</h1>

      <div class="atlas-pin animate-in" style="--delay: 0.35s">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg" class="pin-icon">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="var(--color-atlas-pin)"/>
        </svg>
        <span class="pin-ring"></span>
        <span class="pin-ring pin-ring-2"></span>
      </div>

      <div class="atlas-rule animate-in" style="--delay: 0.4s"></div>
      <div class="atlas-desc animate-in" style="--delay: 0.45s">
        <p>An interactive map to chart everywhere you've been.</p>
        <p class="atlas-actions">Pin your locations. Track your countries. Build your atlas.</p>
      </div>
      <a href={base} class="atlas-back animate-in" style="--delay: 0.55s">&larr; Back to portfolio</a>
    </div>
  </section>
</Base>

<style>
  .atlas-page {
    --color-atlas-blue: #2b6cb0;
    --color-atlas-pin: #d62828;
    --color-atlas-line: #a8bdd4;
    --color-atlas-bg: #f0f4f8;

    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: var(--header-height) var(--space-sm) var(--space-lg);
    background: var(--color-atlas-bg);
  }

  @media (prefers-color-scheme: dark) {
    .atlas-page:not([data-theme="light"]) {
      --color-atlas-line: rgba(255, 255, 255, 0.2);
      --color-atlas-blue: #5a9fe6;
      --color-atlas-bg: var(--color-bg);
    }
  }

  :root[data-theme="dark"] .atlas-page {
    --color-atlas-line: rgba(255, 255, 255, 0.2);
    --color-atlas-blue: #5a9fe6;
    --color-atlas-bg: var(--color-bg);
  }

  .atlas-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .compass-rose {
    position: absolute;
    width: 80%;
    max-width: 550px;
    opacity: 1;
    animation: compass-drift 90s linear infinite;
  }

  .compass-svg {
    width: 100%;
    height: auto;
  }

  @keyframes compass-drift {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Route lines */
  .route-lines {
    position: absolute;
    width: 90%;
    max-width: 700px;
    height: auto;
    opacity: 0.8;
  }

  .route-path {
    animation: route-flow 6s linear infinite;
  }

  @keyframes route-flow {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -40; }
  }

  .route-dot {
    animation: dot-pulse 3s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%, 100% { opacity: 0.3; r: 2; }
    50% { opacity: 0.6; r: 3.5; }
  }

  /* Map dots */
  .map-dots {
    position: absolute;
    inset: 0;
  }

  .dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-atlas-blue);
    animation: dot-blink 4s ease-in-out infinite;
  }

  .dot-1 { top: 28%; left: 22%; animation-delay: 0s; }
  .dot-2 { top: 18%; right: 30%; animation-delay: 1.2s; }
  .dot-3 { bottom: 35%; left: 18%; animation-delay: 2.4s; }
  .dot-4 { bottom: 25%; right: 22%; animation-delay: 0.6s; }
  .dot-5 { top: 45%; left: 35%; animation-delay: 1.8s; }
  .dot-6 { top: 38%; right: 18%; animation-delay: 3s; }

  @keyframes dot-blink {
    0%, 100% { opacity: 0; transform: scale(0.5); }
    20% { opacity: 0.7; transform: scale(1); }
    40% { opacity: 0.5; transform: scale(1); }
    60% { opacity: 0; transform: scale(0.5); }
  }

  /* Corner frame */
  .corner-frame {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .corner {
    position: absolute;
    width: 40px;
    height: 40px;
  }

  .corner::before,
  .corner::after {
    content: '';
    position: absolute;
    background: var(--color-atlas-blue);
    opacity: 0.6;
  }

  .corner::before {
    width: 100%;
    height: 1px;
  }

  .corner::after {
    width: 1px;
    height: 100%;
  }

  .corner-tl { top: 8%; left: 6%; }
  .corner-tl::before { top: 0; left: 0; }
  .corner-tl::after { top: 0; left: 0; }

  .corner-tr { top: 8%; right: 6%; }
  .corner-tr::before { top: 0; right: 0; }
  .corner-tr::after { top: 0; right: 0; }

  .corner-bl { bottom: 8%; left: 6%; }
  .corner-bl::before { bottom: 0; left: 0; }
  .corner-bl::after { bottom: 0; left: 0; }

  .corner-br { bottom: 8%; right: 6%; }
  .corner-br::before { bottom: 0; right: 0; }
  .corner-br::after { bottom: 0; right: 0; }

  /* Coordinates */
  .coord-lines {
    position: absolute;
    inset: 0;
    opacity: 0.55;
  }

  .coord {
    position: absolute;
    font-size: 0.5rem;
    font-family: var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .coord-tl { top: 20%; left: 8%; }
  .coord-tr { top: 15%; right: 8%; }
  .coord-bl { bottom: 20%; left: 8%; }
  .coord-br { bottom: 15%; right: 8%; }
  .coord-ml { top: 50%; left: 8%; }
  .coord-mr { top: 50%; right: 8%; }

  /* Content */
  .atlas-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .atlas-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-atlas-blue);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .atlas-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 11vw, 9rem);
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin-bottom: 0.25rem;
  }

  /* Pulsing pin */
  .atlas-pin {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-xs) 0;
  }

  .pin-icon {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 2px 6px rgba(214, 40, 40, 0.3));
    animation: pin-bob 3s ease-in-out infinite;
  }

  @keyframes pin-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  .pin-ring {
    position: absolute;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1px solid var(--color-atlas-pin);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pin-ripple 3s ease-out infinite;
  }

  .pin-ring-2 {
    animation-delay: 1s;
  }

  @keyframes pin-ripple {
    0% { width: 12px; height: 12px; opacity: 0.5; }
    100% { width: 50px; height: 50px; opacity: 0; }
  }

  .atlas-rule {
    width: 48px;
    height: 1px;
    background: var(--color-atlas-blue);
    opacity: 0.7;
  }

  .atlas-desc {
    text-align: center;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .atlas-desc p {
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .atlas-actions {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--color-atlas-blue);
    opacity: 0.85;
  }

  .atlas-back {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    font-weight: 500;
    transition: color 0.2s ease;
    margin-top: var(--space-sm);
  }

  .atlas-back:hover {
    color: var(--color-accent);
  }

  @media (max-width: 639px) {
    .coord-lines {
      display: none;
    }

    .corner-frame {
      display: none;
    }

    .route-lines {
      width: 120%;
    }
  }
</style>
