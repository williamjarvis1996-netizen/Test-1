---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Atlas | Will Jarvis">
  <section class="atlas-page">
    <div class="atlas-bg" aria-hidden="true">
      <svg viewBox="0 0 800 400" xmlns="http://www.w3.org/2000/svg" class="globe-svg">
        <circle cx="400" cy="200" r="160" fill="none" stroke="var(--color-atlas)" stroke-width="1" opacity="0.15"/>
        <ellipse cx="400" cy="200" rx="160" ry="60" fill="none" stroke="var(--color-atlas)" stroke-width="0.5" opacity="0.1"/>
        <ellipse cx="400" cy="200" rx="120" ry="160" fill="none" stroke="var(--color-atlas)" stroke-width="0.5" opacity="0.1"/>
        <ellipse cx="400" cy="200" rx="50" ry="160" fill="none" stroke="var(--color-atlas)" stroke-width="0.5" opacity="0.1"/>
        <line x1="240" y1="200" x2="560" y2="200" stroke="var(--color-atlas)" stroke-width="0.5" opacity="0.1"/>
        <line x1="400" y1="40" x2="400" y2="360" stroke="var(--color-atlas)" stroke-width="0.5" opacity="0.1"/>
        <circle cx="400" cy="200" r="160" fill="none" stroke="var(--color-atlas)" stroke-width="0.8" opacity="0.08" stroke-dasharray="3 5"/>
        <g class="atlas-dots" fill="var(--color-atlas-gold)" opacity="0.6">
          <circle cx="370" cy="120" r="3"/><circle cx="380" cy="115" r="2.5"/>
          <circle cx="390" cy="125" r="2"/><circle cx="365" cy="130" r="2"/>
          <circle cx="395" cy="118" r="2.5"/><circle cx="375" cy="140" r="2"/>
          <circle cx="385" cy="135" r="1.5"/><circle cx="400" cy="128" r="2"/>
          <circle cx="355" cy="145" r="2"/><circle cx="410" cy="155" r="2.5"/>
          <circle cx="340" cy="180" r="2"/><circle cx="320" cy="195" r="2.5"/>
          <circle cx="325" cy="185" r="2"/><circle cx="460" cy="165" r="2"/>
          <circle cx="500" cy="190" r="2.5"/><circle cx="310" cy="210" r="2"/>
          <circle cx="330" cy="220" r="1.5"/><circle cx="480" cy="175" r="2"/>
        </g>
      </svg>
    </div>

    <div class="atlas-content">
      <p class="atlas-label animate-in" style="--delay: 0.1s">*Atlas of Wanderings</p>
      <h1 class="atlas-title animate-in" style="--delay: 0.25s">Coming<br/>Soon</h1>
      <p class="atlas-desc animate-in" style="--delay: 0.4s">
        An interactive map of everywhere I've been. 26 countries, 5 continents, 180 locations charted.
      </p>
      <div class="atlas-stats animate-in" style="--delay: 0.5s">
        <div class="stat">
          <span class="stat-num">26</span>
          <span class="stat-label">Countries</span>
        </div>
        <div class="stat">
          <span class="stat-num">5</span>
          <span class="stat-label">Continents</span>
        </div>
        <div class="stat">
          <span class="stat-num">180</span>
          <span class="stat-label">Charted</span>
        </div>
      </div>
      <a href={base} class="atlas-back animate-in" style="--delay: 0.6s">&larr; Back to portfolio</a>
    </div>
  </section>
</Base>

<style>
  :root {
    --color-atlas: #2d8cf0;
    --color-atlas-gold: #d4a843;
  }

  .atlas-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: var(--header-height) var(--space-sm) var(--space-lg);
  }

  .atlas-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .globe-svg {
    width: 90%;
    max-width: 700px;
    height: auto;
    animation: spin-slow 60s linear infinite;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .atlas-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .atlas-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-atlas);
    font-weight: 600;
  }

  .atlas-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 10rem);
    text-transform: uppercase;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-fg);
  }

  .atlas-desc {
    font-size: 1rem;
    color: var(--color-fg-muted);
    max-width: 380px;
    line-height: 1.6;
  }

  .atlas-stats {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-md) 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--color-atlas-gold);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 600;
  }

  .atlas-back {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .atlas-back:hover {
    color: var(--color-atlas);
  }

  @media (max-width: 639px) {
    .atlas-stats {
      gap: var(--space-md);
    }
  }
</style>
