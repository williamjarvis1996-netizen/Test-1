---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;

const siteUrl = 'https://williamjarvis1996-netizen.github.io/Test-1';
const aboutJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Will Jarvis",
    "url": siteUrl,
    "image": `${siteUrl}/images/portrait.webp`,
    "jobTitle": "Creative Producer & Scriptwriter",
    "worksFor": {
      "@type": "Organization",
      "name": "RD Content",
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "London",
      "addressCountry": "GB",
    },
    "alumniOf": [
      {
        "@type": "EducationalOrganization",
        "name": "Royal Central School of Speech and Drama",
      },
      {
        "@type": "EducationalOrganization",
        "name": "University of Exeter",
      },
    ],
    "knowsAbout": ["Branded Content", "Film Production", "Scriptwriting", "TV Development", "Theatre"],
    "sameAs": [
      "https://www.imdb.com/name/nm15210832/",
      "https://www.linkedin.com/in/will-t-jarvis/",
      "https://www.instagram.com/willjarvis.1996/",
    ],
  },
};

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'About', url: `${siteUrl}/about` },
];
---

<Base title="About | Will Jarvis" description="Creative Producer at RD Content and scriptwriter with projects in development with Netflix, ITV, and Fandango Productions. MA from Royal Central School of Speech and Drama." jsonLd={aboutJsonLd} breadcrumbs={breadcrumbs}>
  <section class="about-hero">
    <div class="hero-name-bg" aria-hidden="true">
      <span>Will</span>
      <span>Jarvis</span>
    </div>

    <div class="hero-content">
      <div class="hero-photo animate-in" style="--delay: 0.2s">
        <img src={`${base}/images/portrait.webp`} alt="Will Jarvis, Creative Producer and Scriptwriter based in London" class="portrait" />
      </div>

      <div class="hero-intro animate-in" style="--delay: 0.35s">
        <h1 class="intro-headline">Creative Producer & Scriptwriter</h1>
        <p class="intro-location">Hackney, London</p>
        <p class="intro-tagline">
          Story-first producer and writer, working across branded content,
          film, and scripted television.
        </p>
      </div>
    </div>
  </section>

  <section class="about-bio">
    <div class="container">
      <div class="bio-layout">
        <div class="bio-label animate-in" style="--delay: 0.4s">
          <h2>Biography</h2>
        </div>
        <div class="bio-text animate-in" style="--delay: 0.45s">
          <div class="bio-block">
            <h3 class="bio-subhead">Production</h3>
            <p>
              Creative Producer at RD Content, a global branded content agency and
              Cannes Production Company of the Year. Leads end-to-end production
              across Sport, Commercial, Gaming, and Finance, with budgets from
              &#163;50k to &#163;500k and shoots across Europe, North America, the
              Middle East, and Asia.
            </p>
            <p>
              Previously Head of Content and Production at Vidi Guides, where he
              spent four years building out 100+ immersive travel podcasts and audio
              tours for clients including Walt Disney, Hilton Hotels, Lonely Planet,
              and Culture Trip.
            </p>
          </div>
          <div class="bio-block">
            <h3 class="bio-subhead">Writing</h3>
            <p>
              Co-created Break A Leg (dark comedy thriller, in development with
              Netflix, ITV, and Hager Moss) and Brain Drain (apocalyptic adventure
              comedy, optioned by Fandango Productions).
            </p>
            <p>
              Wrote and directed short film Dinner, Diamonds and Death, targeting
              Sundance London. Co-produced Aortic, winner of the Jury Award for Best
              Performance at the Rob Knox London Film Festival 2025.
            </p>
          </div>
          <div class="bio-block">
            <h3 class="bio-subhead">Theatre & Independent</h3>
            <p>
              Co-founded Distracted Rat Productions in 2019. Wrote and directed the
              sold-out play The Clockwork Arms, produced The Emoji Project at Camden
              Fringe, and created Remote Radioplays during lockdown.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-details">
    <div class="container">
      <div class="details-grid">
        <div class="detail-col animate-in" style="--delay: 0.5s">
          <h2>Education</h2>
          <div class="detail-item">
            <strong>Royal Central School of Speech & Drama</strong>
            <span>MA Writing for Stage & Broadcast Media, High Merit</span>
          </div>
          <div class="detail-item">
            <strong>University of Exeter</strong>
            <span>BA English Literature & Drama, 2:1</span>
            <span>1st Class Honours in English Research Dissertation</span>
          </div>
        </div>

        <div class="detail-col animate-in" style="--delay: 0.55s">
          <h2>Recognition</h2>
          <ul class="recognition-list">
            <li>Cannes Corporate Media & TV Awards 2026 (Hamilton Power Up, Booking.com TRA)</li>
            <li>MUSE Awards 2026: three Platinum, one Gold (Booking.com TRA)</li>
            <li>London Library Emerging Writer</li>
            <li>Jury Award for Best Performance, Rob Knox London Film Festival 2025 (Aortic)</li>
          </ul>
        </div>

        <div class="detail-col animate-in" style="--delay: 0.6s">
          <h2>Links</h2>
          <ul class="links-list">
            <li><a href="https://www.imdb.com/name/nm15210832/" target="_blank" rel="noopener">IMDb &rarr;</a></li>
            <li><a href="https://www.linkedin.com/in/will-t-jarvis/" target="_blank" rel="noopener">LinkedIn &rarr;</a></li>
            <li><a href="https://www.instagram.com/willjarvis.1996/" target="_blank" rel="noopener">Instagram &rarr;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <a href={`${base}/contact`} class="cta-link animate-in" style="--delay: 0s">
        <span>Let's work together</span>
        <span class="cta-arrow">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding-top: var(--header-height);
    display: flex;
    align-items: center;
  }

  .hero-name-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    line-height: 0.85;
    pointer-events: none;
    z-index: 0;
  }

  .hero-name-bg span {
    font-family: var(--font-display);
    font-size: clamp(8rem, 22vw, 28rem);
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.08;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - var(--header-height));
    align-items: center;
  }

  .hero-photo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
  }

  .portrait {
    width: 100%;
    max-width: 500px;
    object-fit: cover;
  }

  .hero-intro {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .intro-headline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin: 0;
  }

  .intro-location {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 600;
  }

  .intro-tagline {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    max-width: 420px;
  }

  .about-bio {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .bio-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-lg);
  }

  .bio-label h2 {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted);
    font-weight: 600;
    font-family: var(--font-body);
  }

  .bio-text {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .bio-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .bio-subhead {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    font-weight: 600;
    font-family: var(--font-body);
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border);
  }

  .bio-text p {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-fg);
  }

  .about-details {
    padding: var(--space-lg) 0 var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .detail-col h2 {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
    font-family: var(--font-body);
  }

  .detail-item {
    padding: var(--space-xs) 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .detail-item + .detail-item {
    border-top: 1px solid var(--color-border);
  }

  .detail-item strong {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .detail-item span {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }

  .recognition-list,
  .links-list {
    list-style: none;
  }

  .recognition-list li,
  .links-list li {
    padding: var(--space-xs) 0;
    font-size: 0.8125rem;
    color: var(--color-fg);
    line-height: 1.5;
  }

  .recognition-list li + li,
  .links-list li + li {
    border-top: 1px solid var(--color-border);
  }

  .links-list a {
    color: var(--color-fg);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .links-list a:hover {
    color: var(--color-accent);
  }

  .cta {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-transform: uppercase;
    color: var(--color-fg);
    transition: color 0.2s ease;
    line-height: 1;
  }

  .cta-link:hover {
    color: var(--color-accent);
  }

  .cta-arrow {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    font-size: 0.65em;
  }

  .cta-link:hover .cta-arrow {
    transform: translateX(12px);
  }

  @media (max-width: 1023px) {
    .bio-layout {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  @media (max-width: 767px) {
    .hero-content {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: var(--space-lg);
    }

    .hero-photo {
      padding: var(--space-md);
    }

    .portrait {
      max-width: 300px;
    }

    .hero-intro {
      padding: 0 var(--space-sm) var(--space-lg);
    }

    .about-hero {
      min-height: auto;
    }

    .details-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
