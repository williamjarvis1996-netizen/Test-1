---
import Base from '../layouts/Base.astro';
---

<Base title="About | Will Jarvis">
  <section class="about-hero">
    <div class="container">
      <p class="about-label animate-in" style="--delay: 0.1s">About</p>
      <h1 class="animate-in" style="--delay: 0.2s">Will Jarvis</h1>
      <p class="about-lead animate-in" style="--delay: 0.35s">
        Creative Producer and Screenwriter based in Hackney, London.
        Story-first thinker with a focus on interactivity, human connection,
        neurodivergence, social structures, and grounded sci-fi.
      </p>
    </div>
  </section>

  <section class="about-content">
    <div class="container">
      <div class="content-grid">
        <div class="about-photo animate-in" style="--delay: 0.4s">
          <div class="photo-placeholder">
            <span>Photo</span>
          </div>
        </div>

        <div class="about-bio animate-in" style="--delay: 0.45s">
          <p>
            Currently a Creative Producer at RD Content, an award-winning global
            branded content agency and Cannes Production Company of the Year.
            Leading end-to-end production across Sport, Commercial, Gaming, and
            Finance verticals with budgets from &#163;50k to &#163;500k across
            Europe, North America, and Asia.
          </p>
          <p>
            Before RD, spent four years as Head of Content and Production at
            Vidi Guides, overseeing 100+ immersive travel podcasts with
            partnerships including Walt Disney, Hilton Hotels, Lonely Planet,
            and Culture Trip.
          </p>
          <p>
            As a writer, developing scripted television with production
            companies, broadcasters, and streamers including Netflix, ITV, and
            Hager Moss. Break A Leg (dark comedy thriller) and Brain Drain
            (apocalyptic adventure comedy, optioned by Fandango Productions)
            are both in active development.
          </p>
          <p>
            Co-founded Distracted Rat Productions in 2019, producing new
            writing festivals and radio play series during lockdown. Writer
            and director of short film Dinner, Diamonds and Death (in
            post-production, targeting Sundance London) and co-producer of
            Aortic (Jury Award for Best Performance, Rob Knox London Film
            Festival 2025).
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-details">
    <div class="container">
      <div class="details-grid">
        <div class="detail-block animate-in" style="--delay: 0.5s">
          <h3>Education</h3>
          <ul>
            <li>
              <strong>Royal Central School of Speech & Drama</strong><br />
              MA Writing for Stage & Broadcast Media, High Merit
            </li>
            <li>
              <strong>University of Exeter</strong><br />
              BA English Literature & Drama, 2:1<br />
              1st Class Honours in English Research Dissertation
            </li>
          </ul>
        </div>

        <div class="detail-block animate-in" style="--delay: 0.55s">
          <h3>Recognition</h3>
          <ul>
            <li>London Library Emerging Writer</li>
            <li>Rob Knox Film Festival, Jury Award for Best Performance (Aortic)</li>
            <li>Brain Drain optioned by Fandango Productions</li>
            <li>University of Exeter Award for Outstanding Achievements</li>
          </ul>
        </div>

        <div class="detail-block animate-in" style="--delay: 0.6s">
          <h3>Links</h3>
          <ul class="links-list">
            <li><a href="https://www.imdb.com/name/nm15210832/" target="_blank" rel="noopener">IMDb &rarr;</a></li>
            <li><a href="https://www.linkedin.com/in/will-t-jarvis/" target="_blank" rel="noopener">LinkedIn &rarr;</a></li>
            <li><a href="https://www.instagram.com/willjarvis1996/" target="_blank" rel="noopener">Instagram &rarr;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    padding-top: calc(var(--header-height) + var(--space-xl));
    padding-bottom: var(--space-lg);
  }

  .about-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
    font-weight: 600;
  }

  .about-hero h1 {
    margin-bottom: var(--space-sm);
  }

  .about-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-fg-muted);
    max-width: 560px;
  }

  .about-content {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .photo-placeholder {
    aspect-ratio: 3 / 4;
    max-width: 320px;
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-marker);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
  }

  .about-bio p {
    color: var(--color-fg);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
    font-size: 0.9375rem;
  }

  .about-details {
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .detail-block h3 {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
  }

  .detail-block ul {
    list-style: none;
  }

  .detail-block li {
    padding: var(--space-xs) 0;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .detail-block li + li {
    border-top: 1px solid var(--color-border);
  }

  .detail-block li strong {
    font-weight: 600;
  }

  .links-list a {
    color: var(--color-fg);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .links-list a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .content-grid {
      grid-template-columns: 280px 1fr;
    }

    .details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
