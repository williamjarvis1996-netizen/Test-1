---
import Base from '../layouts/Base.astro';

const siteUrl = 'https://willjarvis.co';
const contactJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Will Jarvis",
  "description": "Contact Will Jarvis for enquiries about branded content production, creative direction, scripted development, and freelance writing.",
  "url": `${siteUrl}/contact`,
  "mainEntity": {
    "@type": "Person",
    "name": "Will Jarvis",
    "email": "williamjarvis1996@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Hackney, London",
      "addressCountry": "GB",
    },
  },
};

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'Contact', url: `${siteUrl}/contact` },
];
---

<Base title="Contact | Will Jarvis" description="Contact Will Jarvis, Creative Producer and Scriptwriter based in London, for enquiries about branded content production, creative direction, and freelance writing." keywords={['Will Jarvis', 'William Jarvis', 'Creative Producer', 'Creative Producer London', 'Contact Will Jarvis', 'Branded Content Producer', 'Commercial Producer London', 'Scriptwriter London']} jsonLd={contactJsonLd} breadcrumbs={breadcrumbs}>
  <section class="contact-page">
    <div class="contact-layout">
      <div class="contact-left">
        <p class="contact-tag animate-in" style="--delay: 0.1s">Get in touch</p>
        <h1 class="contact-headline animate-in" style="--delay: 0.2s">
          <span>Let's</span>
          <span>work</span>
          <span>together</span>
        </h1>
      </div>

      <div class="contact-right">
        <p class="contact-intro animate-in" style="--delay: 0.3s">
          For enquiries about branded content production, creative direction,
          scripted development, and freelance writing.
        </p>

        <div class="contact-email animate-in" style="--delay: 0.4s">
          <a href="mailto:williamjarvis1996@gmail.com" class="email-btn">Email me</a>
          <a href="mailto:williamjarvis1996@gmail.com" class="email-address">williamjarvis1996@gmail.com</a>
        </div>

        <div class="contact-socials animate-in" style="--delay: 0.5s">
          <a href="https://www.instagram.com/willjarvis.1996/" target="_blank" rel="noopener" class="social-link">
            <span class="social-name">Instagram</span>
            <span class="social-arrow">&rarr;</span>
          </a>
          <a href="https://www.linkedin.com/in/will-t-jarvis/" target="_blank" rel="noopener" class="social-link">
            <span class="social-name">LinkedIn</span>
            <span class="social-arrow">&rarr;</span>
          </a>
          <a href="https://www.imdb.com/name/nm15210832/" target="_blank" rel="noopener" class="social-link">
            <span class="social-name">IMDb</span>
            <span class="social-arrow">&rarr;</span>
          </a>
        </div>

        <p class="contact-location animate-in" style="--delay: 0.6s">Based in Hackney, London</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-page {
    min-height: calc(100vh - var(--header-height));
    padding-top: var(--header-height);
    display: flex;
    align-items: center;
  }

  .contact-layout {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-md);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .contact-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .contact-headline {
    line-height: 0.9;
  }

  .contact-headline span {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: var(--color-fg);
  }

  .contact-intro {
    font-size: 1rem;
    color: var(--color-fg-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
    max-width: 420px;
  }

  /* Tier 1: Email */
  .contact-email {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: var(--space-lg);
  }

  .email-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1rem 2.5rem;
    transition: background 0.2s ease, transform 0.2s ease;
    align-self: flex-start;
  }

  .email-btn:hover {
    background: #a51f1f;
    transform: translateY(-1px);
  }

  .email-address {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .email-address:hover {
    color: var(--color-accent);
  }

  /* Tier 2: Socials */
  .contact-socials {
    display: flex;
    gap: 1px;
    margin-bottom: var(--space-lg);
  }

  .social-link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    margin-left: -1px;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    color: var(--color-fg);
  }

  .social-link:first-child {
    margin-left: 0;
  }

  .social-link:hover {
    background: var(--color-bg-muted);
    border-color: var(--color-fg-muted);
    color: var(--color-accent);
    z-index: 1;
  }

  .social-name {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .social-arrow {
    font-size: 0.875rem;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .social-link:hover .social-arrow {
    transform: translateX(3px);
  }

  /* Tier 3: Location */
  .contact-location {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 500;
    opacity: 0.6;
  }

  @media (max-width: 767px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding: var(--space-lg) var(--space-sm);
    }

    .contact-headline span {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .email-btn {
      width: 100%;
    }

    .contact-socials {
      flex-direction: column;
      gap: 0;
    }

    .social-link {
      margin-left: 0;
      margin-top: -1px;
    }

    .social-link:first-child {
      margin-top: 0;
    }
  }
</style>
