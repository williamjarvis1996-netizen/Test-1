---
import Base from '../layouts/Base.astro';
---

<Base title="Contact | Will Jarvis">
  <section class="contact-page">
    <div class="container">
      <div class="contact-content">
        <p class="contact-label animate-in" style="--delay: 0.1s">Contact</p>
        <h1 class="animate-in" style="--delay: 0.2s">Get in<br />touch</h1>
        <p class="contact-intro animate-in" style="--delay: 0.35s">
          Available for branded content production, creative direction,
          scripted development, and freelance writing.
        </p>

        <div class="contact-methods animate-in" style="--delay: 0.5s">
          <div class="contact-block">
            <h3>Email</h3>
            <a href="mailto:williamjarvis1996@gmail.com" class="contact-email">williamjarvis1996@gmail.com</a>
          </div>

          <div class="contact-block">
            <h3>Elsewhere</h3>
            <ul>
              <li><a href="https://www.imdb.com/name/nm15210832/" target="_blank" rel="noopener">IMDb</a></li>
              <li><a href="https://www.linkedin.com/in/will-t-jarvis/" target="_blank" rel="noopener">LinkedIn</a></li>
              <li><a href="https://www.instagram.com/willjarvis1996/" target="_blank" rel="noopener">Instagram</a></li>
            </ul>
          </div>

          <div class="contact-block">
            <h3>Based in</h3>
            <p>Hackney, London</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-page {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
  }

  .contact-content {
    max-width: 520px;
    padding: var(--space-xl) 0;
  }

  .contact-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
    font-weight: 600;
  }

  .contact-content h1 {
    margin-bottom: var(--space-sm);
  }

  .contact-intro {
    font-size: 1rem;
    color: var(--color-fg-muted);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-block h3 {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-xs);
    font-weight: 600;
  }

  .contact-email {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-fg);
    position: relative;
    display: inline-block;
  }

  .contact-email::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .contact-email:hover {
    color: var(--color-accent);
  }

  .contact-email:hover::after {
    transform: scaleX(1);
  }

  .contact-block p {
    color: var(--color-fg);
    font-size: 1rem;
  }

  .contact-block ul {
    list-style: none;
    display: flex;
    gap: var(--space-sm);
  }

  .contact-block ul a {
    font-size: 0.875rem;
    color: var(--color-fg);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .contact-block ul a:hover {
    color: var(--color-accent);
  }
</style>
