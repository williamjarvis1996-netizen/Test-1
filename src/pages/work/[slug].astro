---
import Base from '../../layouts/Base.astro';
import { projects, categories, getThumb } from '../../content/projects';
import type { Project } from '../../content/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const base = import.meta.env.BASE_URL;
const siteUrl = 'https://williamjarvis1996-netizen.github.io/Test-1';
const { project } = Astro.props;
const idx = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(idx + 1) % projects.length];

const categoryToGenre: Record<string, string> = {
  branded: 'Branded Content',
  film: 'Short Film',
  tv: 'Television',
  theatre: 'Theatre',
  digital: 'Digital Media',
};

const projectJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": project.title,
  "description": project.description[0],
  "genre": categoryToGenre[project.category] || project.category,
  "url": `${siteUrl}/work/${project.slug}`,
  ...(project.image && { "image": `${siteUrl}/${project.image}` }),
  "creator": {
    "@type": "Person",
    "name": "Will Jarvis",
    "url": siteUrl,
  },
  ...(project.client && { "producer": { "@type": "Organization", "name": project.client } }),
  ...(project.awards && project.awards.length > 0 && {
    "award": project.awards,
  }),
};

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
  { name: 'Projects', url: `${siteUrl}/work` },
  { name: project.title, url: `${siteUrl}/work/${project.slug}` },
];
---

<Base title={`${project.title} | Will Jarvis`} description={project.description[0]} image={project.image} type="article" jsonLd={projectJsonLd} breadcrumbs={breadcrumbs}>
  <article class="project-detail">
    <div class="detail-layout">
      <div class="detail-media">
        <div class="media-placeholder animate-in" style="--delay: 0.2s">
          {project.image ? (
            <img src={`${base}/${project.image}`} alt={project.title} class="media-photo" />
          ) : (
            <span class="media-num">{project.num}</span>
          )}
        </div>
        {project.description.length > 1 && !project.image && (
          <div class="media-placeholder secondary animate-in" style="--delay: 0.4s">
            <span class="media-label">Production Still</span>
          </div>
        )}
      </div>

      <div class="detail-content">
        <a href={`${base}/work`} class="back-btn animate-in" style="--delay: 0.1s">
          <span class="back-arrow">&larr;</span>
          <span>Back</span>
        </a>

        <header class="detail-header animate-in" style="--delay: 0.2s">
          <h1>{project.title}</h1>
        </header>

        <div class="detail-meta animate-in" style="--delay: 0.3s">
          {project.client && (
            <div class="meta-row">
              <span class="meta-key">Client</span>
              <span class="meta-value">{project.client}</span>
            </div>
          )}
          <div class="meta-row">
            <span class="meta-key">Role</span>
            <span class="meta-value">{project.role}</span>
          </div>
          <div class="meta-row">
            <span class="meta-key">Year</span>
            <span class="meta-value">{project.year}</span>
          </div>
          <div class="meta-row">
            <span class="meta-key">Category</span>
            <span class="meta-value">{categories[project.category]}</span>
          </div>
          {project.details && project.details.map((d) => (
            <div class="meta-row">
              <span class="meta-key">{d.key}</span>
              <span class="meta-value">{d.value}</span>
            </div>
          ))}
        </div>

        <div class="detail-body animate-in" style="--delay: 0.4s">
          {project.description.map((p) => (
            <p>{p}</p>
          ))}
        </div>

        {project.links && project.links.length > 0 && (
          <div class="detail-links animate-in" style="--delay: 0.45s">
            {project.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener" class="video-link">
                <span class="video-icon">&#9654;</span>
                <span>{link.label}</span>
              </a>
            ))}
          </div>
        )}

        {project.awards && project.awards.length > 0 && (
          <div class="detail-awards animate-in" style="--delay: 0.5s">
            <h2>Recognition</h2>
            <ul>
              {project.awards.map((award) => <li>{award}</li>)}
            </ul>
          </div>
        )}

        <nav class="detail-next animate-in" style="--delay: 0.55s">
          <a href={`${base}/work/${next.slug}`} class="next-link">
            <span class="next-label">Next Project</span>
            <span class="next-title">{next.title} &rarr;</span>
          </a>
        </nav>
      </div>
    </div>
  </article>
</Base>

<style>
  .project-detail {
    padding-top: var(--header-height);
    min-height: 100vh;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - var(--header-height));
  }

  .detail-media {
    position: sticky;
    top: var(--header-height);
    height: calc(100vh - var(--header-height));
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--color-bg-muted);
  }

  .media-placeholder {
    min-height: 60vh;
    background: var(--color-bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .media-placeholder.secondary {
    min-height: 40vh;
  }

  .media-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-num {
    font-family: var(--font-display);
    font-size: clamp(5rem, 10vw, 10rem);
    color: var(--color-border);
    letter-spacing: 0.02em;
  }

  .media-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-marker);
    font-weight: 500;
  }

  .detail-content {
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    transition: gap 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    align-self: flex-start;
  }

  .back-btn:hover {
    color: var(--color-accent);
    gap: 0.75rem;
  }

  .back-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  .detail-header h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .detail-meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .meta-key {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 600;
    flex-shrink: 0;
  }

  .meta-value {
    font-size: 0.8125rem;
    color: var(--color-fg);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .detail-body p {
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-fg);
    margin-bottom: var(--space-sm);
  }

  .detail-body p:last-child {
    margin-bottom: 0;
  }

  .detail-links {
    padding-top: var(--space-xs);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .video-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    background: var(--color-accent);
    padding: 0.75rem 1.5rem;
    transition: background 0.2s ease;
  }

  .video-link:hover {
    background: #a51f1f;
  }

  .video-icon {
    font-size: 0.5rem;
    line-height: 1;
    position: relative;
    top: 0.5px;
  }

  .detail-awards {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-sm);
  }

  .detail-awards h2 {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-xs);
    font-weight: 600;
    font-family: var(--font-body);
  }

  .detail-awards ul {
    list-style: none;
  }

  .detail-awards li {
    font-size: 0.8125rem;
    color: var(--color-fg);
    padding: 0.375rem 0;
    line-height: 1.5;
  }

  .detail-awards li + li {
    border-top: 1px solid var(--color-border);
  }

  .detail-next {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }

  .next-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-fg);
    transition: color 0.2s ease;
  }

  .next-link:hover {
    color: var(--color-accent);
  }

  .next-label {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 600;
  }

  .next-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.5rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  @media (max-width: 1023px) {
    .detail-content {
      padding: var(--space-md) var(--space-md) var(--space-lg);
    }
  }

  @media (max-width: 767px) {
    .detail-layout {
      grid-template-columns: 1fr;
    }

    .detail-media {
      position: relative;
      top: 0;
      height: auto;
    }

    .media-placeholder {
      min-height: 40vh;
    }

    .detail-content {
      padding: var(--space-md) var(--space-sm) var(--space-lg);
    }
  }
</style>
