---
import Base from '../../layouts/Base.astro';
import { projects, categories } from '../../content/projects';
import type { Project } from '../../content/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Base title={`${project.title} | Will Jarvis`} description={project.description}>
  <article class="project-detail">
    <div class="container">
      <header class="project-header animate-in" style="--delay: 0.15s">
        <div class="project-meta">
          {project.client && <span>{project.client}</span>}
          <span>{project.year}</span>
          <span>{categories[project.category]}</span>
        </div>
        <h1>{project.title}</h1>
        <p class="project-role">{project.role}</p>
      </header>

      <div class="project-body animate-in" style="--delay: 0.3s">
        <p class="project-description">{project.description}</p>

        {project.longDescription && (
          <div class="project-long">
            <p>{project.longDescription}</p>
          </div>
        )}

        {project.credits && project.credits.length > 0 && (
          <div class="project-credits">
            <h3>Credits</h3>
            <ul>
              {project.credits.map((credit) => <li>{credit}</li>)}
            </ul>
          </div>
        )}

        {project.awards && project.awards.length > 0 && (
          <div class="project-awards">
            <h3>Awards</h3>
            <ul>
              {project.awards.map((award) => <li>{award}</li>)}
            </ul>
          </div>
        )}

        {project.links && project.links.length > 0 && (
          <div class="project-links">
            {project.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener" class="project-ext-link">
                {link.label} &rarr;
              </a>
            ))}
          </div>
        )}
      </div>

      <nav class="project-nav">
        <a href="/work">&larr; All work</a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .project-detail {
    padding-top: calc(var(--header-height) + var(--space-xl));
  }

  .project-header {
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  .project-meta span + span::before {
    content: '/';
    margin-right: var(--space-sm);
    color: var(--color-border);
  }

  .project-header h1 {
    font-size: clamp(2.5rem, 7vw, 6rem);
    margin-bottom: var(--space-xs);
  }

  .project-role {
    font-size: 1rem;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .project-body {
    padding-bottom: var(--space-lg);
    max-width: 680px;
  }

  .project-description {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-fg);
    margin-bottom: var(--space-md);
  }

  .project-long p {
    color: var(--color-fg-muted);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .project-credits,
  .project-awards {
    margin-bottom: var(--space-md);
  }

  .project-credits h3,
  .project-awards h3 {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-xs);
    font-weight: 600;
  }

  .project-credits ul,
  .project-awards ul {
    list-style: none;
    color: var(--color-fg);
  }

  .project-credits li,
  .project-awards li {
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .project-ext-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .project-ext-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .project-nav {
    padding: var(--space-md) 0 var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .project-nav a {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .project-nav a:hover {
    color: var(--color-accent);
  }
</style>
