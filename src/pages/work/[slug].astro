---
import Base from '../../layouts/Base.astro';
import { projects, categories } from '../../content/projects';
import type { Project } from '../../content/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Base title={`${project.title} | Will Jarvis`} description={project.description}>
  <article class="project-detail">
    <div class="project-hero">
      <div class="project-hero-grain"></div>
      {project.image ? (
        <img src={project.image} alt={project.title} class="project-hero-image" />
      ) : (
        <div class="project-hero-placeholder">
          <div class="project-hero-glow"></div>
          <div class="container">
            <span class="project-hero-badge">{categories[project.category]}</span>
          </div>
        </div>
      )}
    </div>

    <div class="container">
      <header class="project-header animate-in" style="--delay: 0.15s">
        <div class="project-meta">
          {project.client && <span>{project.client}</span>}
          <span>{project.year}</span>
          <span>{categories[project.category]}</span>
        </div>
        <h1>{project.title}</h1>
        <p class="project-role">{project.role}</p>
      </header>

      <div class="project-body animate-in" style="--delay: 0.3s">
        <p class="project-description">{project.description}</p>

        {project.longDescription && (
          <div class="project-long">
            <p>{project.longDescription}</p>
          </div>
        )}

        {project.credits && project.credits.length > 0 && (
          <div class="project-credits">
            <h3>Credits</h3>
            <ul>
              {project.credits.map((credit) => <li>{credit}</li>)}
            </ul>
          </div>
        )}

        {project.awards && project.awards.length > 0 && (
          <div class="project-awards">
            <h3>Awards</h3>
            <ul>
              {project.awards.map((award) => <li>{award}</li>)}
            </ul>
          </div>
        )}

        {project.links && project.links.length > 0 && (
          <div class="project-links">
            {project.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener" class="project-ext-link">
                {link.label} &rarr;
              </a>
            ))}
          </div>
        )}
      </div>

      <nav class="project-nav">
        <a href="/work">&larr; All work</a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .project-detail {
    padding-top: var(--header-height);
  }

  .project-hero {
    position: relative;
    overflow: hidden;
  }

  .project-hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px;
    pointer-events: none;
    z-index: 1;
  }

  .project-hero-placeholder {
    width: 100%;
    aspect-ratio: 21 / 9;
    background: linear-gradient(135deg, var(--color-bg-elevated) 0%, var(--color-bg-card) 100%);
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-md);
    position: relative;
  }

  .project-hero-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 300px;
    background: radial-gradient(ellipse, rgba(200, 164, 90, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .project-hero-image {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  .animate-in {
    opacity: 0;
    transform: translateY(24px);
    animation: fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-hero-badge {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
  }

  .project-header {
    padding: var(--space-lg) 0 var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .project-meta span + span::before {
    content: '/';
    margin-right: var(--space-sm);
    color: var(--color-border);
  }

  .project-header h1 {
    color: var(--color-white);
    margin-bottom: var(--space-xs);
  }

  .project-role {
    font-size: 1.125rem;
    color: var(--color-accent);
  }

  .project-body {
    padding: var(--space-lg) 0;
    max-width: 720px;
  }

  .project-description {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .project-long p {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .project-credits,
  .project-awards {
    margin-bottom: var(--space-md);
  }

  .project-credits h3,
  .project-awards h3 {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .project-credits ul,
  .project-awards ul {
    list-style: none;
    color: var(--color-text);
  }

  .project-credits li,
  .project-awards li {
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .project-ext-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .project-ext-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .project-nav {
    padding: var(--space-md) 0 var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .project-nav a {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    position: relative;
    display: inline-block;
  }

  .project-nav a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .project-nav a:hover {
    color: var(--color-accent);
  }

  .project-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
