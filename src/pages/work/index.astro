---
import Base from '../../layouts/Base.astro';
import { projects, categories } from '../../content/projects';

const categoryKeys = Object.keys(categories) as (keyof typeof categories)[];
const grouped = categoryKeys.map((key) => ({
  key,
  label: categories[key],
  items: projects.filter((p) => p.category === key),
})).filter((g) => g.items.length > 0);
---

<Base title="Work | Will Jarvis">
  <section class="work-page">
    <div class="work-header">
      <div class="container">
        <p class="work-tag animate-in" style="--delay: 0.1s">*Selected Work</p>
        <p class="work-intro animate-in" style="--delay: 0.2s">
          Branded content, short film, scripted television, theatre and immersive.
        </p>
      </div>
    </div>

    {grouped.map((group, gi) => (
      <div class="work-category">
        <div class="container">
          <h2 class="cat-label animate-in" style={`--delay: ${0.1 + gi * 0.05}s`}>{group.label}</h2>
        </div>
        <div class="container">
          <div class="project-grid">
            {group.items.map((project, i) => (
              <a href={`/work/${project.slug}`} class={`project-card ${i === 0 && group.items.length > 2 ? 'card-wide' : ''}`}>
                <div class="card-img">
                  <span class="card-num">{project.num}</span>
                </div>
                <div class="card-info">
                  <span class="card-client">{project.client || group.label}</span>
                  <span class="card-title">{project.title}</span>
                  <span class="card-meta">{project.role} / {project.year}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </section>
</Base>

<style>
  .work-page {
    min-height: 100vh;
    padding-top: var(--header-height);
  }

  .work-header {
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .work-tag {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .work-intro {
    font-size: 1rem;
    color: var(--color-fg-muted);
    max-width: 480px;
    line-height: 1.6;
  }

  .work-category {
    padding-bottom: var(--space-xl);
  }

  .cat-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
    font-family: var(--font-body);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }

  .card-wide {
    grid-column: span 2;
  }

  .project-card {
    position: relative;
    display: block;
    overflow: hidden;
    color: var(--color-fg);
  }

  .card-img {
    aspect-ratio: 4 / 3;
    background: var(--color-bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: background 0.5s ease;
  }

  .card-wide .card-img {
    aspect-ratio: 8 / 3;
  }

  .project-card:hover .card-img {
    background: var(--color-fg);
  }

  .card-num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    color: var(--color-border);
    letter-spacing: 0.02em;
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .card-num {
    opacity: 0;
    transform: scale(1.1);
  }

  .card-info {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: var(--space-sm);
    text-align: center;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project-card:hover .card-info {
    opacity: 1;
  }

  .card-client {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-accent);
    font-weight: 600;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(0.875rem, 1.8vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-bg);
    line-height: 1.2;
  }

  .card-meta {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 639px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .card-wide {
      grid-column: span 1;
    }

    .card-wide .card-img {
      aspect-ratio: 4 / 3;
    }

    .card-info {
      opacity: 1;
      background: linear-gradient(transparent 40%, rgba(0, 0, 0, 0.7));
      justify-content: flex-end;
      padding-bottom: var(--space-md);
    }

    .card-num {
      opacity: 0.3;
    }
  }
</style>
