---
import Base from '../../layouts/Base.astro';
import { projects, categories } from '../../content/projects';

const categoryKeys = Object.keys(categories) as (keyof typeof categories)[];
---

<Base title="Work | Will Jarvis">
  <section class="work-hero">
    <div class="container">
      <p class="work-label animate-in" style="--delay: 0.1s">Portfolio</p>
      <h1 class="animate-in" style="--delay: 0.2s">Work</h1>
      <p class="work-intro animate-in" style="--delay: 0.35s">
        Branded content, short film, scripted television, theatre and immersive.
      </p>
    </div>
  </section>

  <section class="work-filters">
    <div class="container">
      <div class="filter-bar" role="tablist">
        <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">All</button>
        {categoryKeys.map((key) => (
          <button class="filter-btn" data-filter={key} role="tab" aria-selected="false">
            {categories[key]}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="work-list">
    <div class="container">
      <div class="list-header">
        <span class="lh-num">No.</span>
        <span class="lh-client">Client</span>
        <span class="lh-title">Project</span>
        <span class="lh-year">Year</span>
        <span class="lh-role">Role</span>
        <span class="lh-arrow"></span>
      </div>
      {projects.map((project, i) => (
        <a href={`/work/${project.slug}`} class="project-row" data-category={project.category}>
          <span class="row-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="row-client">{project.client || categories[project.category]}</span>
          <span class="row-title">{project.title}</span>
          <span class="row-year">{project.year}</span>
          <span class="row-role">{project.role}</span>
          <span class="row-arrow">&rarr;</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .work-hero {
    padding-top: calc(var(--header-height) + var(--space-xl));
    padding-bottom: var(--space-lg);
  }

  .work-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
    font-weight: 600;
  }

  .work-hero h1 {
    margin-bottom: var(--space-sm);
  }

  .work-intro {
    font-size: 1rem;
    color: var(--color-fg-muted);
    max-width: 480px;
    line-height: 1.6;
  }

  .work-filters {
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .filter-btn {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    padding: 0.375rem 0.875rem;
    font-size: 0.6875rem;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--color-fg-muted);
    color: var(--color-fg);
  }

  .filter-btn.active {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .work-list {
    padding: var(--space-sm) 0 var(--space-xl);
  }

  .list-header {
    display: grid;
    grid-template-columns: 3rem 1fr 2fr 5rem 1fr 1.5rem;
    gap: 0 var(--space-sm);
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-marker);
    font-weight: 500;
  }

  .project-row {
    display: grid;
    grid-template-columns: 3rem 1fr 2fr 5rem 1fr 1.5rem;
    gap: 0 var(--space-sm);
    align-items: baseline;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s ease;
    color: var(--color-fg);
  }

  .project-row:hover {
    color: var(--color-accent);
  }

  .project-row.hidden {
    display: none;
  }

  .row-num {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .project-row:hover .row-num {
    color: var(--color-accent);
  }

  .row-client {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .project-row:hover .row-client {
    color: inherit;
  }

  .row-title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    min-width: 0;
  }

  .row-year {
    font-size: 0.8125rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
  }

  .project-row:hover .row-year {
    color: inherit;
  }

  .row-role {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  .project-row:hover .row-role {
    color: inherit;
  }

  .row-arrow {
    font-size: 0.875rem;
    color: var(--color-border);
    transition: transform 0.2s ease, color 0.15s ease;
  }

  .project-row:hover .row-arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  @media (max-width: 1023px) {
    .list-header {
      grid-template-columns: 2.5rem 1fr 1.5fr 4rem 1.5rem;
    }

    .project-row {
      grid-template-columns: 2.5rem 1fr 1.5fr 4rem 1.5rem;
    }

    .row-role,
    .lh-role {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .list-header {
      display: none;
    }

    .project-row {
      grid-template-columns: 2rem 1fr 1.5rem;
      padding: 0.75rem 0;
    }

    .row-client,
    .row-year,
    .row-role {
      display: none;
    }

    .row-title {
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const rows = document.querySelectorAll('.project-row');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      buttons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      rows.forEach((row) => {
        const el = row as HTMLElement;
        if (filter === 'all' || el.dataset.category === filter) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    });
  });
</script>
