---
import Base from '../../layouts/Base.astro';
import { projects, categories, getThumb } from '../../content/projects';

const base = import.meta.env.BASE_URL;

const seasonVal: Record<string, number> = { Spring: 0, Summer: 1, Autumn: 2, Winter: 3 };
function yearScore(y: string): number {
  if (y.includes('-')) return parseInt(y.split('-')[1]) * 10 + 9;
  const [s, yr] = y.split(' ');
  return parseInt(yr) * 10 + (seasonVal[s] ?? 0);
}

const categoryOrder = ['branded', 'film', 'tv', 'theatre', 'digital'] as const;
const grouped = categoryOrder.map(cat => ({
  key: cat,
  label: categories[cat],
  items: projects
    .filter(p => p.category === cat)
    .sort((a, b) => yearScore(b.year) - yearScore(a.year)),
})).filter(g => g.items.length > 0);
---

<Base title="Projects | Will Jarvis" description="Selected projects by Will Jarvis spanning branded content for Hamilton Watches, Booking.com, Chelsea FC, and Manchester City FC, alongside short films, TV development, theatre, and digital media.">
  <section class="work-page">
    <div class="work-header">
      <div class="container">
        <h1 class="work-tag animate-in" style="--delay: 0.1s">Selected Projects</h1>
        <p class="work-intro animate-in" style="--delay: 0.2s">
          Branded content, short film, scripted television, theatre, immersive and digital media.
        </p>
      </div>
    </div>

    <div class="container">
      {grouped.map((group) => (
        <div class="cat-section">
          <div class="cat-header animate-in" style="--delay: 0.15s">
            <span class="cat-label">{group.label}</span>
            <span class="cat-count">{String(group.items.length).padStart(2, '0')} Projects</span>
          </div>
          <div class="project-grid">
            {group.items.map((project) => (
              <a href={`${base}/work/${project.slug}`} class={`project-card ${project.wide ? 'card-wide' : ''}`}>
                <div class="card-img">
                  {project.image ? (
                    <img src={`${base}/${getThumb(project.image) || project.image}`} alt={project.title} class="card-photo" loading="lazy" {...(getThumb(project.image) ? { 'data-gif': `${base}/${project.image}` } : {})} />
                  ) : (
                    <span class="card-num">{project.num}</span>
                  )}
                  <div class="card-overlay">
                    <span class="overlay-role">{project.role}</span>
                    <span class="overlay-arrow">&rarr;</span>
                  </div>
                </div>
                <div class="card-caption">
                  <span class="caption-client">{project.client || group.label}</span>
                  <span class="caption-title">{project.title}</span>
                  <span class="caption-year">{project.year}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .work-page {
    min-height: 100vh;
    padding-top: var(--header-height);
  }

  .work-header {
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .work-tag {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    font-weight: 400;
  }

  .work-intro {
    font-size: 1rem;
    color: var(--color-fg-muted);
    max-width: 480px;
    line-height: 1.6;
  }

  .cat-section + .cat-section {
    margin-top: var(--space-lg);
  }

  .cat-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-md);
  }

  .cat-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted);
    font-weight: 600;
    font-family: var(--font-body);
    line-height: 1;
  }

  .cat-count {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-marker);
    font-weight: 500;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .card-wide {
    grid-column: span 2;
  }

  .project-card {
    display: block;
    color: var(--color-fg);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card-img {
    aspect-ratio: 4 / 3;
    background: var(--color-bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: background 0.5s ease;
  }

  .card-wide .card-img {
    aspect-ratio: 8 / 3;
  }

  .project-card:hover .card-img {
    background: var(--color-fg);
  }

  .card-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .card-photo {
    transform: scale(1.03);
  }

  .card-num {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    color: var(--color-border);
    letter-spacing: 0.02em;
    transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .card-num {
    opacity: 0;
    transform: scale(1.1);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project-card:hover .card-overlay {
    opacity: 1;
  }

  .overlay-role {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bg);
    font-weight: 600;
  }

  .overlay-arrow {
    font-size: 1.25rem;
    color: var(--color-bg);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .overlay-arrow {
    transform: translateX(4px);
  }

  .card-caption {
    padding: 0.75rem 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .caption-client {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    font-weight: 600;
    flex-shrink: 0;
  }

  .caption-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-fg);
    letter-spacing: 0.01em;
    min-width: 0;
  }

  .caption-year {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    margin-left: auto;
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  @media (max-width: 1023px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card-wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 639px) {
    .work-header {
      padding: var(--space-md) 0 var(--space-sm);
    }

    .project-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xs);
    }

    .card-wide {
      grid-column: span 2;
    }

    .card-wide .card-img {
      aspect-ratio: 16 / 9;
    }

    .card-img {
      aspect-ratio: 1 / 1;
    }

    .card-caption {
      padding: 0.5rem 0 1rem;
      flex-direction: column;
      gap: 0.125rem;
    }

    .caption-client {
      font-size: 0.5625rem;
    }

    .caption-title {
      font-size: 0.8125rem;
    }

    .caption-year {
      font-size: 0.6875rem;
      margin-left: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      card.style.transform = `perspective(800px) rotateY(${x * 6}deg) rotateX(${y * -6}deg)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });
</script>
