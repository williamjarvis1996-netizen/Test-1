---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeaturedProjects } from '../content/projects';

const featured = getFeaturedProjects();
---

<Base title="Will Jarvis | Creative Producer & Writer">
  <section class="hero">
    <div class="hero-grain"></div>
    <div class="hero-glow"></div>
    <div class="hero-inner container">
      <div class="hero-content">
        <p class="hero-label animate-in" style="--delay: 0.1s">Creative Producer & Writer</p>
        <h1 class="hero-title animate-in" style="--delay: 0.25s">Stories that<br />move people.</h1>
        <p class="hero-sub animate-in" style="--delay: 0.4s">
          Branded content, short film, scripted TV, theatre and immersive.
          Currently at RD Content, London.
        </p>
        <div class="hero-cta animate-in" style="--delay: 0.55s">
          <a href="/work" class="btn btn-primary">View work</a>
          <a href="/about" class="btn btn-ghost">About me</a>
        </div>
      </div>
    </div>
    <div class="hero-scroll">
      <div class="scroll-line"></div>
    </div>
  </section>

  <section class="featured section">
    <div class="container">
      <div class="section-header">
        <h2>Selected Work</h2>
        <a href="/work" class="section-link">View all &rarr;</a>
      </div>
      <div class="project-grid">
        {featured.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <section class="clients section">
    <div class="container">
      <h2 class="visually-hidden">Clients</h2>
      <p class="clients-label">Selected clients</p>
      <div class="clients-list">
        <span class="reveal">Formula 1</span>
        <span class="reveal">Manchester City FC</span>
        <span class="reveal">Booking.com</span>
        <span class="reveal">Morgan Stanley</span>
        <span class="reveal">Hamilton Watches</span>
        <span class="reveal">Aramco</span>
        <span class="reveal">DAMAC Properties</span>
        <span class="reveal">Revolut</span>
        <span class="reveal">Chelsea FC</span>
        <span class="reveal">Walt Disney</span>
        <span class="reveal">Hilton Hotels</span>
        <span class="reveal">Lonely Planet</span>
        <span class="reveal">Netflix</span>
        <span class="reveal">ITV</span>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--header-height);
    position: relative;
    overflow: hidden;
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    left: 30%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(200, 164, 90, 0.08) 0%, transparent 70%);
    pointer-events: none;
    animation: glow-drift 12s ease-in-out infinite alternate;
  }

  @keyframes glow-drift {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(80px, 40px) scale(1.15); }
  }

  .hero-content {
    max-width: 720px;
    position: relative;
    z-index: 1;
  }

  .animate-in {
    opacity: 0;
    transform: translateY(24px);
    animation: fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .hero-title {
    margin-bottom: var(--space-md);
    color: var(--color-white);
    background: linear-gradient(160deg, var(--color-white) 30%, rgba(200, 164, 90, 0.6) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin-bottom: var(--space-md);
    line-height: 1.7;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
  }

  .hero-scroll {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-bg);
  }

  .btn-ghost {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .btn-ghost:hover {
    border-color: var(--color-text-muted);
    color: var(--color-white);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .section-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .section-link:hover {
    color: var(--color-accent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
  }

  .clients-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    text-align: center;
  }

  .clients-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm) var(--space-md);
  }

  .clients-list span {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-weight: 400;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
    position: relative;
  }

  .clients-list span:hover {
    color: var(--color-white);
  }

  .clients-list span::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.3s ease;
  }

  .clients-list span:hover::after {
    width: 100%;
  }

  .reveal {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .clients-list span {
      font-size: 1.125rem;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          el.style.transitionDelay = `${i * 0.06}s`;
          el.classList.add('visible');
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  reveals.forEach((el) => observer.observe(el));
</script>
