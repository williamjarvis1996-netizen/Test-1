---
import Base from '../layouts/Base.astro';
import { projects } from '../content/projects';

const featured = projects.filter(p => p.featured);
---

<Base title="Will Jarvis | Creative Producer & Screenwriter">
  <section class="hero">
    <div class="hero-meta animate-in" style="--delay: 0.1s">
      <div class="meta-block">
        <span class="meta-label">Based in</span>
        <span class="meta-val">Hackney, London</span>
      </div>
      <div class="meta-block">
        <span class="meta-label">Time Check</span>
        <span class="meta-val" id="hero-clock">00:00:00</span>
      </div>
    </div>

    <div class="hero-vertical animate-in" style="--delay: 0.6s">
      <div class="vert-line"></div>
      <div class="vert-text">Every good story starts with a question worth asking</div>
    </div>

    <div class="hero-crosses" aria-hidden="true">
      <span class="cross cross-1"></span>
      <span class="cross cross-2"></span>
      <span class="cross cross-3"></span>
      <span class="cross cross-4"></span>
    </div>

    <div class="hero-content">
      <div class="hero-name">
        <span class="name-line animate-in" style="--delay: 0.2s">Will</span>
        <span class="name-line animate-in" style="--delay: 0.35s">Jarvis</span>
      </div>

      <div class="hero-strip">
        <div class="strip-track">
          {[...featured, ...featured].map((p, i) => (
            <a href={`/work/${p.slug}`} class="strip-item">
              <div class="strip-img">
                <span class="strip-num">{String((i % featured.length) + 1).padStart(2, '0')}</span>
                <span class="strip-title">{p.title}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="hero-discipline animate-in" style="--delay: 0.5s">
        <span class="disc-line">Producer</span>
        <span class="disc-line"><span class="amp">&</span> Screen</span>
        <span class="disc-line">writer</span>
      </div>
    </div>

    <div class="hero-foot animate-in" style="--delay: 0.7s">
      <span class="foot-rule"></span>
      <span class="foot-copy">&copy;2026</span>
    </div>
  </section>

  <section class="clients">
    <div class="container">
      <p class="clients-label">Selected clients</p>
      <div class="clients-list">
        <span class="reveal">Formula 1</span>
        <span class="reveal">Manchester City FC</span>
        <span class="reveal">Booking.com</span>
        <span class="reveal">Morgan Stanley</span>
        <span class="reveal">Hamilton Watches</span>
        <span class="reveal">Aramco</span>
        <span class="reveal">DAMAC Properties</span>
        <span class="reveal">Revolut</span>
        <span class="reveal">Chelsea FC</span>
        <span class="reveal">Walt Disney</span>
        <span class="reveal">Hilton Hotels</span>
        <span class="reveal">Lonely Planet</span>
        <span class="reveal">Netflix</span>
        <span class="reveal">ITV</span>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <a href="/contact" class="cta-link animate-in" style="--delay: 0s">
        <span>Let's work together</span>
        <span class="cta-arrow">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding-top: var(--header-height);
  }

  /* ---- Metadata top-left ---- */
  .hero-meta {
    position: absolute;
    top: calc(var(--header-height) + var(--space-md));
    left: var(--space-md);
    display: flex;
    gap: var(--space-lg);
    z-index: 2;
  }

  .meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
  }

  .meta-label {
    font-size: 0.5625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 600;
  }

  .meta-val {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Vertical spine ---- */
  .hero-vertical {
    position: absolute;
    left: 22%;
    top: calc(var(--header-height) + var(--space-sm));
    bottom: var(--space-sm);
    z-index: 10;
    pointer-events: none;
  }

  .vert-line {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent);
  }

  .vert-text {
    position: absolute;
    left: 12px;
    bottom: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted);
    white-space: nowrap;
  }

  /* ---- Crosshairs ---- */
  .hero-crosses {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .cross {
    position: absolute;
    width: 26px;
    height: 26px;
  }

  .cross::before,
  .cross::after {
    content: '';
    position: absolute;
    background: var(--color-marker);
  }

  .cross::before {
    width: 1px;
    height: 100%;
    left: 50%;
    transform: translateX(-50%);
  }

  .cross::after {
    width: 100%;
    height: 1px;
    top: 50%;
    transform: translateY(-50%);
  }

  .cross-1 {
    top: 20%;
    left: 12%;
    animation: cross-pulse 8s ease-in-out infinite;
  }

  .cross-2 {
    top: 20%;
    left: 30%;
    animation: cross-pulse 12s ease-in-out infinite;
    animation-delay: -4s;
  }

  .cross-3 {
    bottom: 36%;
    left: 8%;
    animation: cross-pulse 10s ease-in-out infinite;
    animation-delay: -2s;
  }

  .cross-4 {
    bottom: 22%;
    left: 26%;
    animation: cross-pulse 14s ease-in-out infinite;
    animation-delay: -6s;
  }

  @keyframes cross-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.15; }
  }

  /* ---- Main content flow ---- */
  .hero-content {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.5rem, 1vw, 1rem);
    position: relative;
    z-index: 2;
  }

  /* ---- Name ---- */
  .hero-name {
    text-align: right;
    padding: 0 var(--space-md);
    line-height: 0.85;
  }

  .name-line {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(5rem, 18vw, 22rem);
    text-transform: uppercase;
    color: var(--color-fg);
    letter-spacing: -0.03em;
  }

  /* ---- Image strip ---- */
  .hero-strip {
    overflow: hidden;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .strip-track {
    display: flex;
    min-width: max-content;
    animation: strip-scroll 45s linear infinite;
  }

  .strip-track:hover {
    animation-play-state: paused;
  }

  @keyframes strip-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .strip-item {
    flex: 0 0 280px;
    border-right: 1px solid var(--color-border);
    cursor: pointer;
  }

  .strip-img {
    aspect-ratio: 5 / 4;
    background: var(--color-bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: background 0.4s ease;
  }

  .strip-item:hover .strip-img {
    background: var(--color-fg);
  }

  .strip-num {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-border);
    letter-spacing: 0.02em;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .strip-item:hover .strip-num {
    opacity: 0;
    transform: translateY(-10px);
  }

  .strip-title {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bg);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease 0.05s, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
    padding: var(--space-sm);
    text-align: center;
    line-height: 1.4;
  }

  .strip-item:hover .strip-title {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- Discipline text ---- */
  .hero-discipline {
    text-align: right;
    padding: 0 var(--space-md);
    line-height: 0.88;
  }

  .disc-line {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 9vw, 11rem);
    text-transform: uppercase;
    color: var(--color-fg);
    letter-spacing: -0.02em;
  }

  .amp {
    color: var(--color-accent);
  }

  /* ---- Bottom-left ---- */
  .hero-foot {
    position: absolute;
    bottom: var(--space-md);
    left: var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    z-index: 2;
  }

  .foot-rule {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--color-fg);
  }

  .foot-copy {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-fg);
  }

  /* ---- Clients ---- */
  .clients {
    padding: var(--space-xl) 0 var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .clients-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
    text-align: center;
    font-weight: 500;
  }

  .clients-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }

  .clients-list span {
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    padding: 0.375rem var(--space-sm);
    transition: color 0.3s ease, transform 0.3s ease, opacity 0.5s ease;
    letter-spacing: 0.01em;
  }

  .clients-list span:hover {
    color: var(--color-accent);
  }

  .reveal {
    opacity: 0;
    transform: translateY(10px);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- CTA ---- */
  .cta {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-transform: uppercase;
    color: var(--color-fg);
    transition: color 0.2s ease;
    line-height: 1;
  }

  .cta-link:hover {
    color: var(--color-accent);
  }

  .cta-arrow {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    font-size: 0.65em;
  }

  .cta-link:hover .cta-arrow {
    transform: translateX(12px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 1023px) {
    .hero-vertical {
      left: 12%;
    }
  }

  @media (max-width: 767px) {
    .hero-meta {
      gap: var(--space-md);
    }

    .hero-vertical {
      display: none;
    }

    .hero-crosses {
      display: none;
    }

    .hero-foot {
      bottom: var(--space-sm);
    }

    .strip-item {
      flex: 0 0 220px;
    }

    .clients-list span {
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  const clock = document.getElementById('hero-clock');
  if (clock) {
    function tick() {
      const now = new Date();
      clock!.textContent = now.toLocaleTimeString('en-GB', {
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
      });
    }
    tick();
    setInterval(tick, 1000);
  }

  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const siblings = Array.from(el.parentElement?.querySelectorAll('.reveal') || []);
          const idx = siblings.indexOf(el);
          el.style.transitionDelay = `${idx * 0.05}s`;
          el.classList.add('visible');
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
  );
  reveals.forEach((el) => observer.observe(el));
</script>
