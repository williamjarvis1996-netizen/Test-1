---
import Base from '../layouts/Base.astro';
import { projects } from '../content/projects';

const featured = projects.filter(p => p.featured);
---

<Base title="Will Jarvis | Creative Producer & Screenwriter">
  <section class="hero">
    <div class="hero-content container">
      <div class="hero-label animate-in" style="--delay: 0.1s">
        <span class="label-line"></span>
        Creative Producer & Screenwriter
      </div>
      <h1 class="hero-title">
        <span class="title-line animate-in" style="--delay: 0.2s">Will</span>
        <span class="title-line animate-in" style="--delay: 0.35s">Jarvis</span>
      </h1>
      <p class="hero-sub animate-in" style="--delay: 0.5s">
        Branded Content <span class="accent">&</span> Screenwriting
      </p>
    </div>

    <div class="hero-vertical animate-in" style="--delay: 0.6s">
      <span class="vertical-line"></span>
      <span class="vertical-text">Stories that move people</span>
    </div>

    <div class="hero-crosses" aria-hidden="true">
      <span class="cross cross-1">+</span>
      <span class="cross cross-2">+</span>
      <span class="cross cross-3">+</span>
    </div>

    <div class="hero-bottom container animate-in" style="--delay: 0.7s">
      <span>Hackney, London</span>
      <span>RD Content</span>
      <span id="hero-year">2026</span>
    </div>
  </section>

  <section class="image-strip">
    <div class="strip-track">
      {featured.map((p, i) => (
        <a href={`/work/${p.slug}`} class="strip-item">
          <div class="strip-inner">
            <span class="strip-number">{String(i + 1).padStart(2, '0')}</span>
            <span class="strip-title">{p.title}</span>
            <span class="strip-client">{p.client || p.role}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="clients section">
    <div class="container">
      <p class="clients-label">Selected clients</p>
      <div class="clients-list">
        <span>Formula 1</span>
        <span>Manchester City FC</span>
        <span>Booking.com</span>
        <span>Morgan Stanley</span>
        <span>Hamilton Watches</span>
        <span>Aramco</span>
        <span>DAMAC Properties</span>
        <span>Revolut</span>
        <span>Chelsea FC</span>
        <span>Walt Disney</span>
        <span>Hilton Hotels</span>
        <span>Lonely Planet</span>
        <span>Netflix</span>
        <span>ITV</span>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--header-height);
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
  }

  .label-line {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--color-accent);
  }

  .hero-title {
    font-size: clamp(4.5rem, 18vw, 15rem);
    line-height: 0.88;
    margin-bottom: var(--space-sm);
  }

  .title-line {
    display: block;
  }

  .hero-sub {
    font-size: clamp(0.75rem, 1.8vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    text-transform: uppercase;
  }

  .hero-vertical {
    position: absolute;
    right: var(--space-md);
    top: calc(var(--header-height) + var(--space-lg));
    bottom: var(--space-lg);
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .vertical-line {
    width: 1px;
    height: 100%;
    background: var(--color-accent);
  }

  .vertical-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.5625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-marker);
    white-space: nowrap;
    align-self: flex-end;
  }

  .hero-crosses {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .cross {
    position: absolute;
    font-size: 1.5rem;
    font-weight: 200;
    color: var(--color-border);
    line-height: 1;
    font-family: var(--font-body);
  }

  .cross-1 { top: 22%; right: 18%; }
  .cross-2 { bottom: 35%; left: 6%; }
  .cross-3 { bottom: 20%; right: 40%; }

  .hero-bottom {
    position: absolute;
    bottom: var(--space-md);
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
  }

  .image-strip {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .image-strip::-webkit-scrollbar {
    display: none;
  }

  .strip-track {
    display: flex;
    min-width: max-content;
  }

  .strip-item {
    flex: 0 0 260px;
    border-right: 1px solid var(--color-border);
    transition: background 0.2s ease;
  }

  .strip-item:hover {
    background: var(--color-bg-muted);
  }

  .strip-inner {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-sm);
    gap: 0.25rem;
  }

  .strip-number {
    font-size: 0.625rem;
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: auto;
  }

  .strip-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-fg);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .strip-client {
    font-size: 0.6875rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.04em;
  }

  .clients {
    padding: var(--space-xl) 0;
  }

  .clients-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
    text-align: center;
    font-weight: 500;
  }

  .clients-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }

  .clients-list span {
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    padding: 0.375rem var(--space-sm);
    transition: color 0.2s ease;
    letter-spacing: 0.01em;
  }

  .clients-list span:hover {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .hero-vertical {
      display: none;
    }

    .hero-bottom {
      gap: var(--space-sm);
    }

    .strip-item {
      flex: 0 0 200px;
    }

    .clients-list span {
      font-size: 0.8125rem;
    }
  }
</style>
