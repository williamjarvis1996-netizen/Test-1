---
import Base from '../layouts/Base.astro';
import { projects } from '../content/projects';

const featured = projects.filter(p => p.featured);
---

<Base title="Will Jarvis | Creative Producer & Screenwriter">
  <section class="hero">
    <div class="hero-content container">
      <div class="hero-label animate-in" style="--delay: 0.1s">
        <span class="label-line"></span>
        Creative Producer & Screenwriter
      </div>
      <h1 class="hero-title">
        <span class="title-line animate-in" style="--delay: 0.2s">Will</span>
        <span class="title-line animate-in" style="--delay: 0.35s">Jarvis</span>
      </h1>
      <p class="hero-sub animate-in" style="--delay: 0.5s">
        Branded Content <span class="accent">&</span> Screenwriting
      </p>
    </div>

    <div class="hero-vertical animate-in" style="--delay: 0.6s">
      <span class="vertical-line"></span>
      <span class="vertical-text">Stories that move people</span>
    </div>

    <div class="hero-crosses" aria-hidden="true">
      <span class="cross cross-1">+</span>
      <span class="cross cross-2">+</span>
      <span class="cross cross-3">+</span>
      <span class="cross cross-4">+</span>
    </div>

    <div class="hero-bottom container animate-in" style="--delay: 0.7s">
      <span>Hackney, London</span>
      <span id="hero-clock"></span>
      <span>2026</span>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>Branded Content</span><span class="marquee-sep">+</span>
      <span>Short Film</span><span class="marquee-sep">+</span>
      <span>Scripted TV</span><span class="marquee-sep">+</span>
      <span>Theatre</span><span class="marquee-sep">+</span>
      <span>Immersive</span><span class="marquee-sep">+</span>
      <span>Branded Content</span><span class="marquee-sep">+</span>
      <span>Short Film</span><span class="marquee-sep">+</span>
      <span>Scripted TV</span><span class="marquee-sep">+</span>
      <span>Theatre</span><span class="marquee-sep">+</span>
      <span>Immersive</span><span class="marquee-sep">+</span>
    </div>
  </div>

  <section class="image-strip">
    <div class="strip-track">
      {[...featured, ...featured].map((p, i) => (
        <a href={`/work/${p.slug}`} class="strip-item">
          <div class="strip-inner">
            <span class="strip-number">{String((i % featured.length) + 1).padStart(2, '0')}</span>
            <span class="strip-title">{p.title}</span>
            <span class="strip-client">{p.client || p.role}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="clients">
    <div class="container">
      <p class="clients-label">Selected clients</p>
      <div class="clients-list">
        <span class="reveal">Formula 1</span>
        <span class="reveal">Manchester City FC</span>
        <span class="reveal">Booking.com</span>
        <span class="reveal">Morgan Stanley</span>
        <span class="reveal">Hamilton Watches</span>
        <span class="reveal">Aramco</span>
        <span class="reveal">DAMAC Properties</span>
        <span class="reveal">Revolut</span>
        <span class="reveal">Chelsea FC</span>
        <span class="reveal">Walt Disney</span>
        <span class="reveal">Hilton Hotels</span>
        <span class="reveal">Lonely Planet</span>
        <span class="reveal">Netflix</span>
        <span class="reveal">ITV</span>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <a href="/contact" class="cta-link animate-in" style="--delay: 0s">
        <span>Let's work together</span>
        <span class="cta-arrow">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--header-height);
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
  }

  .label-line {
    display: block;
    width: 40px;
    height: 1px;
    background: var(--color-accent);
  }

  .hero-title {
    font-size: clamp(4.5rem, 18vw, 15rem);
    line-height: 0.88;
    margin-bottom: var(--space-sm);
  }

  .title-line {
    display: block;
  }

  .hero-sub {
    font-size: clamp(0.75rem, 1.8vw, 1.0625rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    text-transform: uppercase;
  }

  /* Vertical element */
  .hero-vertical {
    position: absolute;
    right: var(--space-md);
    top: calc(var(--header-height) + var(--space-lg));
    bottom: var(--space-lg);
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .vertical-line {
    width: 2px;
    height: 100%;
    background: var(--color-accent);
  }

  .vertical-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--color-fg-muted);
    white-space: nowrap;
    align-self: flex-end;
  }

  /* Animated crosses */
  .hero-crosses {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .cross {
    position: absolute;
    font-weight: 200;
    color: var(--color-border);
    line-height: 1;
    font-family: var(--font-body);
  }

  .cross-1 {
    top: 18%; right: 14%;
    font-size: 1.75rem;
    animation: cross-drift-1 10s ease-in-out infinite alternate;
  }
  .cross-2 {
    bottom: 38%; left: 5%;
    font-size: 1.25rem;
    animation: cross-drift-2 14s ease-in-out infinite alternate;
  }
  .cross-3 {
    bottom: 18%; right: 38%;
    font-size: 1.5rem;
    animation: cross-drift-3 12s ease-in-out infinite alternate;
  }
  .cross-4 {
    top: 50%; right: 26%;
    font-size: 1rem;
    animation: cross-drift-1 16s ease-in-out infinite alternate-reverse;
  }

  @keyframes cross-drift-1 {
    0% { transform: rotate(0deg); opacity: 0.4; }
    100% { transform: rotate(90deg) translate(6px, -4px); opacity: 0.2; }
  }
  @keyframes cross-drift-2 {
    0% { transform: rotate(0deg); opacity: 0.3; }
    100% { transform: rotate(-45deg) translate(-4px, 6px); opacity: 0.15; }
  }
  @keyframes cross-drift-3 {
    0% { transform: rotate(0deg); opacity: 0.35; }
    100% { transform: rotate(60deg) translate(5px, 3px); opacity: 0.18; }
  }

  .hero-bottom {
    position: absolute;
    bottom: var(--space-md);
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    white-space: nowrap;
    width: max-content;
    animation: marquee-scroll 28s linear infinite;
  }

  .marquee-track span {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    text-transform: uppercase;
    color: var(--color-fg);
    flex-shrink: 0;
  }

  .marquee-sep {
    color: var(--color-accent) !important;
    font-size: clamp(1.25rem, 2.5vw, 2rem) !important;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Image strip */
  .image-strip {
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .strip-track {
    display: flex;
    min-width: max-content;
    animation: strip-scroll 50s linear infinite;
  }

  .strip-track:hover {
    animation-play-state: paused;
  }

  @keyframes strip-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .strip-item {
    flex: 0 0 260px;
    border-right: 1px solid var(--color-border);
    transition: background 0.2s ease;
  }

  .strip-item:hover {
    background: var(--color-bg-muted);
  }

  .strip-inner {
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-sm);
    gap: 0.25rem;
  }

  .strip-number {
    font-size: 0.625rem;
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: auto;
  }

  .strip-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-fg);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .strip-client {
    font-size: 0.6875rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.04em;
  }

  /* Clients */
  .clients {
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .clients-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
    text-align: center;
    font-weight: 500;
  }

  .clients-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0;
  }

  .clients-list span {
    font-size: 0.9375rem;
    color: var(--color-fg-muted);
    padding: 0.375rem var(--space-sm);
    transition: color 0.3s ease, transform 0.3s ease, opacity 0.5s ease;
    letter-spacing: 0.01em;
  }

  .clients-list span:hover {
    color: var(--color-accent);
  }

  .reveal {
    opacity: 0;
    transform: translateY(10px);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* CTA */
  .cta {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-transform: uppercase;
    color: var(--color-fg);
    transition: color 0.2s ease;
    line-height: 1;
  }

  .cta-link:hover {
    color: var(--color-accent);
  }

  .cta-arrow {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    font-size: 0.65em;
  }

  .cta-link:hover .cta-arrow {
    transform: translateX(12px);
  }

  @media (max-width: 767px) {
    .hero-vertical {
      display: none;
    }

    .hero-bottom {
      gap: var(--space-sm);
    }

    .strip-item {
      flex: 0 0 200px;
    }

    .clients-list span {
      font-size: 0.8125rem;
    }
  }
</style>

<script>
  const clock = document.getElementById('hero-clock');
  if (clock) {
    function tick() {
      const now = new Date();
      clock!.textContent = now.toLocaleTimeString('en-GB', {
        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
      });
    }
    tick();
    setInterval(tick, 1000);
  }

  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const siblings = Array.from(el.parentElement?.querySelectorAll('.reveal') || []);
          const idx = siblings.indexOf(el);
          el.style.transitionDelay = `${idx * 0.05}s`;
          el.classList.add('visible');
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
  );
  reveals.forEach((el) => observer.observe(el));
</script>
