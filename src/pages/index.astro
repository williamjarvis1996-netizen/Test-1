---
import Base from '../layouts/Base.astro';
import { projects, getThumb } from '../content/projects';

const base = import.meta.env.BASE_URL;

const carouselOrder = [
  'hamilton-in-the-midst-of-it',
  'mcfc-ohana',
  'fora-at-five',
  'chelsea-damac',
  'steaks',
  'booking-traveller-review-awards',
  'dinner-diamonds-and-death',
  'hamilton-into-the-wild',
  'aortic',
  'hamilton-power-up',
  'vidi-guides',
  'break-a-leg',
  'brain-drain',
  'the-clockwork-arms',
  'the-emoji-project',
  'remote-radioplays',
];
const slugIndex = new Map(carouselOrder.map((s, i) => [s, i]));
const featured = [...projects].sort((a, b) =>
  (slugIndex.get(a.slug) ?? 999) - (slugIndex.get(b.slug) ?? 999)
);

const siteUrl = 'https://williamjarvis1996-netizen.github.io/Test-1';

const homepageJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Will Jarvis",
  "url": siteUrl,
  "description": "Will Jarvis is a London-based Creative Producer and Scriptwriter working across branded content, film, TV development, and theatre.",
  "author": {
    "@type": "Person",
    "name": "Will Jarvis",
    "jobTitle": "Creative Producer & Scriptwriter",
    "url": siteUrl,
  },
};

const breadcrumbs = [
  { name: 'Home', url: siteUrl },
];
---

<Base title="Will Jarvis | Creative Producer & Scriptwriter" description="Will Jarvis is a London-based Creative Producer and Scriptwriter working across branded content for Hamilton Watches, Booking.com, and Manchester City FC, alongside film, TV development, and theatre." jsonLd={homepageJsonLd} breadcrumbs={breadcrumbs}>
  <section class="hero">
    <div class="hero-label hero-label-top animate-in" style="--delay: 0.1s">
      <span class="label-text">Based in London</span>
      <span class="label-rule"></span>
    </div>


    <div class="hero-crosses" aria-hidden="true">
      <span class="cross cross-tl"></span>
      <span class="cross cross-tr"></span>
      <span class="cross cross-bl"></span>
      <span class="cross cross-br"></span>
    </div>

    <div class="hero-content">
      <h1 class="hero-name">
        <span class="name-line animate-in" style="--delay: 0.2s" data-scramble="Will">Will</span>
        <span class="name-line animate-in" style="--delay: 0.35s" data-scramble="Jarvis">Jarvis</span>
      </h1>

      <div class="hero-strip">
        <div class="strip-track">
          {[...featured, ...featured].map((p, i) => (
            <a href={`${base}/work/${p.slug}`} class="strip-item">
              <div class="strip-img">
                {p.image ? (
                  <img
                    src={`${base}/${getThumb(p.image) || p.image}`}
                    alt={p.title}
                    class="strip-photo"
                    loading={i < featured.length ? 'eager' : 'lazy'}
                    {...(getThumb(p.image) ? { 'data-gif': `${base}/${p.image}` } : {})}
                  />
                ) : (
                  <span class="strip-num">{p.num}</span>
                )}
                <span class="strip-title"><span>{p.title}</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="hero-bottom">
        <div class="hero-foot animate-in" style="--delay: 0.7s">
          <span class="foot-rule"></span>
          <span class="foot-copy">&copy;2026</span>
        </div>
        <h2 class="hero-discipline animate-in" style="--delay: 0.5s">
          <span class="disc-line">Creative</span>
          <span class="disc-line">Producer <span class="amp">&amp;</span></span>
          <span class="disc-line">Scriptwriter</span>
        </h2>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <a href={`${base}/contact`} class="cta-link animate-in" style="--delay: 0s">
        <span>Get in touch</span>
        <span class="cta-arrow">&rarr;</span>
      </a>
      <a href={`${base}/work`} class="cta-link cta-secondary animate-in" style="--delay: 0.1s">
        <span>Selected work</span>
        <span class="cta-arrow">&rarr;</span>
      </a>
      <a href={`${base}/about`} class="cta-link cta-secondary animate-in" style="--delay: 0.2s">
        <span>A bit about me</span>
        <span class="cta-arrow">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="clients">
    <div class="container">
      <h2 class="clients-label">Brands I've worked with</h2>
      <ul class="clients-list" role="list">
        <li class="reveal">Formula 1</li>
        <li class="reveal">Manchester City FC</li>
        <li class="reveal">Chelsea FC</li>
        <li class="reveal">Booking.com</li>
        <li class="reveal">Hamilton Watches</li>
        <li class="reveal">Fora Travel</li>
        <li class="reveal">DAMAC Properties</li>
        <li class="reveal">Walt Disney</li>
        <li class="reveal">Hilton Hotels</li>
        <li class="reveal">Lonely Planet</li>
        <li class="reveal">Netflix</li>
        <li class="reveal">Culture Trip</li>
        <li class="reveal">Amazon</li>
        <li class="reveal">Cognizant</li>
        <li class="reveal">Ares Management</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding-top: var(--header-height);
  }

  /* ---- Labels ---- */
  .hero-label {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .hero-label-top {
    top: calc(var(--header-height) + var(--space-md));
    left: var(--space-md);
  }


  .label-text {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-fg-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  .label-rule {
    display: block;
    width: 80px;
    height: 1px;
    background: var(--color-fg);
    opacity: 0.4;
  }


  /* ---- Cross marks ---- */
  .hero-crosses {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }

  .cross {
    position: absolute;
    width: 22px;
    height: 22px;
  }

  .cross::before,
  .cross::after {
    content: '';
    position: absolute;
    background: var(--color-fg);
  }

  .cross::before {
    width: 1px;
    height: 100%;
    left: 50%;
    transform: translateX(-50%);
  }

  .cross::after {
    width: 100%;
    height: 1px;
    top: 50%;
    transform: translateY(-50%);
  }

  .cross-tl {
    top: 22%;
    left: 15%;
    opacity: 0.75;
  }

  .cross-tr {
    top: 22%;
    left: 33%;
    opacity: 0.75;
  }

  .cross-bl {
    bottom: 22%;
    left: 15%;
    opacity: 0.75;
  }

  .cross-br {
    bottom: 22%;
    left: 33%;
    opacity: 0.75;
  }

  /* ---- Main content flow ---- */
  .hero-content {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.25rem, 0.5vw, 0.75rem);
    position: relative;
    z-index: 2;
  }

  /* ---- Name ---- */
  .hero-name {
    text-align: right;
    padding: 0 var(--space-md);
    line-height: 0.85;
    font-size: inherit;
    margin: 0;
  }

  .name-line {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 13vw, 15rem);
    text-transform: uppercase;
    color: var(--color-fg);
    letter-spacing: -0.03em;
  }

  /* ---- Image strip ---- */
  .hero-strip {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hero-strip::-webkit-scrollbar {
    display: none;
  }

  .strip-track {
    display: flex;
    gap: 6px;
    min-width: max-content;
  }

  .strip-item {
    flex: 0 0 380px;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .strip-img {
    aspect-ratio: 16 / 9;
    background: var(--color-bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: background 0.4s ease;
  }

  .strip-item:hover .strip-img {
    background: var(--color-fg);
  }

  .strip-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .strip-item:hover .strip-photo {
    transform: scale(1.05);
  }

  .strip-num {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-border);
    letter-spacing: 0.02em;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .strip-item:hover .strip-num {
    opacity: 0;
    transform: translateY(-10px);
  }

  .strip-title {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bg);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease 0.05s, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1) 0.05s;
    padding: var(--space-sm);
    text-align: center;
    line-height: 1.4;
  }

  .strip-title span {
    background: var(--color-accent);
    padding: 0.35em 0.75em;
    line-height: 1.4;
  }

  .strip-item:hover .strip-title {
    opacity: 1;
    transform: translateY(0);
  }


  /* ---- Bottom row: foot + discipline ---- */
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: last baseline;
    padding: 0 var(--space-md);
    padding-bottom: var(--space-md);
  }

  /* ---- Discipline text ---- */
  .hero-discipline {
    text-align: right;
    line-height: 0.9;
    margin: 0;
  }

  .disc-line {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 7rem);
    text-transform: uppercase;
    color: var(--color-fg);
    letter-spacing: -0.02em;
    opacity: 0.7;
  }

  .amp {
    color: var(--color-accent);
  }

  /* ---- Bottom-left ---- */
  .hero-foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 2;
    flex-shrink: 0;
  }

  .foot-rule {
    display: block;
    width: 48px;
    height: 1px;
    background: var(--color-fg);
    opacity: 0.35;
  }

  .foot-copy {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-muted);
  }

  /* ---- Clients ---- */
  .clients {
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
  }

  .clients-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-md);
    text-align: center;
    font-weight: 600;
    font-family: var(--font-body);
  }

  .clients-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0;
    max-width: 900px;
    margin: 0 auto;
    list-style: none;
  }

  .clients-list li {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg);
    opacity: 0.25;
    padding: 0.625rem var(--space-sm);
    transition: opacity 0.3s ease;
  }

  .clients-list li:hover {
    opacity: 0.8;
  }

  .reveal {
    opacity: 0;
    transform: translateY(10px);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- CTA ---- */
  .cta {
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .cta .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .cta-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    text-transform: uppercase;
    color: var(--color-fg);
    transition: color 0.2s ease;
    line-height: 1.1;
  }

  .cta-link:hover {
    color: var(--color-accent);
  }

  .cta-arrow {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    font-size: 0.65em;
    flex-shrink: 0;
  }

  .cta-link:hover .cta-arrow {
    transform: translateX(12px);
  }

  .cta-secondary {
    font-size: clamp(1.25rem, 3vw, 2rem);
    color: var(--color-fg-muted);
  }

  .cta-secondary:hover {
    color: var(--color-accent);
  }

  /* ---- Responsive ---- */
  @media (max-width: 767px) {
    .hero {
      min-height: 75vh;
      min-height: 75dvh;
    }

    .cross {
      width: 14px;
      height: 14px;
      opacity: 0.4;
    }

    .cross-tl { top: 18%; left: 8%; }
    .cross-tr { top: 18%; right: 8%; left: auto; }
    .cross-bl { bottom: 18%; left: 8%; }
    .cross-br { display: none; }

    .hero-content {
      min-height: calc(75vh - var(--header-height));
      min-height: calc(75dvh - var(--header-height));
      padding-top: 0;
      padding-bottom: 0;
      gap: var(--space-sm);
      justify-content: flex-start;
    }

    .hero-content::before {
      content: '';
      flex: 1;
      min-height: var(--space-lg);
    }

    .hero-name {
      padding: 0 var(--space-sm);
      line-height: 0.88;
    }

    .name-line {
      font-size: clamp(3rem, 12vw, 4rem);
    }

    .hero-bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
      padding: 0 var(--space-sm);
      padding-bottom: var(--space-sm);
      gap: 0;
      flex: 1;
      min-height: 0;
      justify-content: space-between;
    }

    .hero-discipline {
      align-self: flex-end;
      padding-bottom: 0;
    }

    .disc-line {
      font-size: clamp(1.3rem, 5.5vw, 2rem);
    }

    .hero-label-top {
      top: calc(var(--header-height) + var(--space-xs));
      left: var(--space-sm);
    }

    .strip-item {
      flex: 0 0 200px;
    }

    .strip-img {
      aspect-ratio: 16 / 10;
    }

    .clients {
      padding: var(--space-md) 0;
    }

    .clients-label {
      margin-bottom: var(--space-sm);
      text-align: left;
    }

    .clients-list {
      justify-content: flex-start;
      gap: 0;
    }

    .clients-list li {
      font-size: 0.8125rem;
      padding: 0.375rem 0.5rem;
    }

    .cta {
      min-height: 25vh;
      min-height: 25dvh;
      padding: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .cta .container {
      display: block;
    }

    .cta-link {
      font-size: clamp(1.5rem, 7vw, 2rem);
      display: block;
      margin-bottom: var(--space-xs);
    }

    .cta-link > span,
    .cta-arrow {
      display: inline;
    }

    .cta-arrow {
      margin-left: 0.15em;
    }

    .cta-secondary {
      font-size: clamp(1rem, 4.5vw, 1.5rem);
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const siblings = Array.from(el.parentElement?.querySelectorAll('.reveal') || []);
          const idx = siblings.indexOf(el);
          el.style.transitionDelay = `${idx * 0.05}s`;
          el.classList.add('visible');
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
  );
  reveals.forEach((el) => observer.observe(el));

  // Scramble text effect on hero name
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
    const target = el.dataset.scramble!;
    const delay = parseFloat(getComputedStyle(el).animationDelay) * 1000;
    let frame = 0;
    const duration = 20;

    setTimeout(() => {
      const interval = setInterval(() => {
        el.textContent = target
          .split('')
          .map((ch, i) =>
            i < (frame / duration) * target.length
              ? target[i]
              : chars[Math.floor(Math.random() * chars.length)]
          )
          .join('');
        frame++;
        if (frame > duration) {
          el.textContent = target;
          clearInterval(interval);
        }
      }, 30);
    }, delay);
  });

  // Magnetic tilt on strip items
  document.querySelectorAll<HTMLElement>('.strip-item').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      card.style.transform = `perspective(600px) rotateY(${x * 8}deg) rotateX(${y * -8}deg)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });

  // Auto-scroll carousel with pause on interaction
  const strip = document.querySelector<HTMLElement>('.hero-strip');
  if (strip) {
    const speed = 0.7;
    let paused = false;
    let resumeTimer: ReturnType<typeof setTimeout>;

    strip.addEventListener('mouseenter', () => {
      paused = true;
      clearTimeout(resumeTimer);
    });
    strip.addEventListener('mouseleave', () => {
      resumeTimer = setTimeout(() => { paused = false; }, 600);
    });
    strip.addEventListener('touchstart', () => {
      paused = true;
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { paused = false; }, 3000);
    }, { passive: true });
    strip.addEventListener('wheel', () => {
      paused = true;
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { paused = false; }, 2000);
    }, { passive: true });

    let prev = 0;
    function tick(ts: number) {
      if (!paused) {
        const dt = prev ? ts - prev : 16;
        strip!.scrollLeft += speed * (dt / 16);
        const half = strip!.scrollWidth / 2;
        if (strip!.scrollLeft >= half) {
          strip!.scrollLeft -= half;
        }
      }
      prev = ts;
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
